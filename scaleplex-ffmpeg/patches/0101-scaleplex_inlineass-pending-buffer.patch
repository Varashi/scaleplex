 }
 
 void scaleplex_inlineass_handle_subtitle(AVCodecContext *dec_ctx, AVSubtitle *sub)
 {
+    InlineAssBinding *b = NULL;
+
     if (!dec_ctx || !sub)
         return;
 
     pthread_mutex_lock(&bindings_lock);
+
+    /* Fast path: dec_ctx already pinned to a binding. */
     for (int i = 0; i < nb_bindings; i++) {
-        if (bindings[i].dec_ctx == dec_ctx && bindings[i].flt_ctx) {
-            av_log(NULL, AV_LOG_VERBOSE,
-                   "scaleplex_inlineass: handle_subtitle bind#%d dec_ctx=%p flt_ctx=%p rects=%d\n",
-                   i, (void*)dec_ctx, (void*)bindings[i].flt_ctx, sub->num_rects);
-            avfilter_inlineass_append_data(bindings[i].flt_ctx, dec_ctx, sub);
+        if (bindings[i].dec_ctx == dec_ctx) {
+            b = &bindings[i];
             break;
         }
     }
+
+    /* Slow path: eager-bind by looking up ist->decoder. Fires the
+     * first time handle_subtitle runs ahead of link_graph (sidecar
+     * input drained before the video graph configured). */
+    if (!b) {
+        for (int i = 0; i < nb_bindings; i++) {
+            if (bindings[i].ist && bindings[i].ist->decoder &&
+                dec_get_avctx(bindings[i].ist->decoder) == dec_ctx) {
+                bindings[i].dec_ctx = dec_ctx;
+                b = &bindings[i];
+                av_log(NULL, AV_LOG_VERBOSE,
+                       "scaleplex_inlineass: eager-bound dec_ctx=%p to bind#%td (pre-graph)\n",
+                       (void*)dec_ctx, b - bindings);
+                break;
+            }
+        }
+    }
+
+    if (!b) {
+        pthread_mutex_unlock(&bindings_lock);
+        return;
+    }
+
+    for (int i = 0; i < sub->num_rects; i++) {
+        AVSubtitleRect *rect = sub->rects[i];
+        int64_t duration_ms, start_ms;
+        if (!rect || !rect->ass)
+            continue;
+        duration_ms = sub->end_display_time - sub->start_display_time;
+        start_ms    = av_rescale_q(sub->pts, AV_TIME_BASE_Q,
+                                   av_make_q(1, 1000));
+        start_ms   += sub->start_display_time;
+
+        if (b->flt_ctx) {
+            av_log(NULL, AV_LOG_VERBOSE,
+                   "scaleplex_inlineass: handle_subtitle bind#%td dec_ctx=%p flt_ctx=%p rects=%d\n",
+                   b - bindings, (void*)dec_ctx, (void*)b->flt_ctx, sub->num_rects);
+            avfilter_inlineass_replay_chunk(b->flt_ctx, dec_ctx,
+                                            start_ms, duration_ms, rect->ass);
+        } else {
+            av_log(NULL, AV_LOG_VERBOSE,
+                   "scaleplex_inlineass: buffer chunk bind#%td start=%" PRId64 " dur=%" PRId64 " queued=%d\n",
+                   b - bindings, start_ms, duration_ms, b->pending_count);
+            pending_push(b, start_ms, duration_ms, rect->ass);
+        }
+    }
+
     pthread_mutex_unlock(&bindings_lock);
 }
 
 void scaleplex_inlineass_uninit(void)
 {
     pthread_mutex_lock(&bindings_lock);
-    for (int i = 0; i < nb_bindings; i++)
+    for (int i = 0; i < nb_bindings; i++) {
+        pending_free(&bindings[i]);
         av_freep(&bindings[i].stream_spec);
+    }
     av_freep(&bindings);
     nb_bindings = 0;
     pthread_mutex_unlock(&bindings_lock);
