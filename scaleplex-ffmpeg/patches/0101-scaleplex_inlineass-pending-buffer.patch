 #include "libavutil/error.h"
 #include "libavutil/log.h"
 #include "libavutil/mem.h"
+#include "libavutil/rational.h"
+
+/* Cap pending-chunk queue per binding. A 2-hour movie at ~3 subs/sec
+ * upper bound = ~22k. 4096 covers any realistic pre-graph backlog
+ * (handful of seconds), well under that. Above the cap we drop +
+ * warn — subs were going to misalign anyway. */
+#define INLINEASS_PENDING_MAX 4096
+
+typedef struct PendingSubChunk {
+    int64_t start_ms;       /* ASS_TIME_BASE (1/1000)                */
+    int64_t duration_ms;    /* same                                  */
+    char   *ass_line;       /* av_strdup'd; freed in drain/uninit    */
+    struct PendingSubChunk *next;
+} PendingSubChunk;
 
 typedef struct InlineAssBinding {
     int               file_idx;
     char             *stream_spec;
     InputStream      *ist;          /* resolved at option-parse time */
-    AVCodecContext   *dec_ctx;      /* resolved at link-graph time   */
+    AVCodecContext   *dec_ctx;      /* eager-set by handle_subtitle, */
+                                    /* re-set at link-graph time     */
     AVFilterContext  *flt_ctx;      /* resolved at link-graph time   */
+    PendingSubChunk  *pending_head;
+    PendingSubChunk  *pending_tail;
+    int               pending_count;
+    int               pending_dropped;
 } InlineAssBinding;
 
 static InlineAssBinding *bindings;
 static int               nb_bindings;
 static pthread_mutex_t   bindings_lock = PTHREAD_MUTEX_INITIALIZER;
 
+/* Caller holds bindings_lock. */
+static void pending_push(InlineAssBinding *b, int64_t start_ms,
+                         int64_t duration_ms, const char *ass_line)
+{
+    PendingSubChunk *p;
+
+    if (b->pending_count >= INLINEASS_PENDING_MAX) {
+        if (!b->pending_dropped)
+            av_log(NULL, AV_LOG_WARNING,
+                   "scaleplex_inlineass: bind#%td pending queue full (>%d), "
+                   "dropping further chunks\n",
+                   b - bindings, INLINEASS_PENDING_MAX);
+        b->pending_dropped++;
+        return;
+    }
+
+    p = av_mallocz(sizeof(*p));
+    if (!p)
+        return;
+    p->start_ms    = start_ms;
+    p->duration_ms = duration_ms;
+    p->ass_line    = av_strdup(ass_line);
+    if (!p->ass_line) {
+        av_free(p);
+        return;
+    }
+    p->next = NULL;
+    if (b->pending_tail)
+        b->pending_tail->next = p;
+    else
+        b->pending_head = p;
+    b->pending_tail = p;
+    b->pending_count++;
+}
+
+/* Caller holds bindings_lock AND b->flt_ctx is set. Drains the queue
+ * into the filter via the side-channel replay helper. */
+static void pending_drain(InlineAssBinding *b)
+{
+    PendingSubChunk *p = b->pending_head;
+    int n = 0;
+
+    while (p) {
+        PendingSubChunk *next = p->next;
+        avfilter_inlineass_replay_chunk(b->flt_ctx, b->dec_ctx,
+                                        p->start_ms, p->duration_ms,
+                                        p->ass_line);
+        av_freep(&p->ass_line);
+        av_freep(&p);
+        p = next;
+        n++;
+    }
+    b->pending_head  = NULL;
+    b->pending_tail  = NULL;
+    if (n)
+        av_log(NULL, AV_LOG_VERBOSE,
+               "scaleplex_inlineass: drained %d pending chunks into bind#%td "
+               "(dropped=%d)\n",
+               n, b - bindings, b->pending_dropped);
+    b->pending_count   = 0;
+    b->pending_dropped = 0;
+}
+
+/* Caller holds bindings_lock. Used when link_graph rebinds (probe→live)
+ * or at uninit. */
+static void pending_free(InlineAssBinding *b)
+{
+    PendingSubChunk *p = b->pending_head;
+    while (p) {
+        PendingSubChunk *next = p->next;
+        av_freep(&p->ass_line);
+        av_freep(&p);
+        p = next;
+    }
+    b->pending_head  = NULL;
+    b->pending_tail  = NULL;
+    b->pending_count   = 0;
+    b->pending_dropped = 0;
+}
+
