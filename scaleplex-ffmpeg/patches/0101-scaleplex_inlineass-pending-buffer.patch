-     * freed AVFilterContext from a previous graph. */
+     * freed AVFilterContext from a previous graph. Keep pending chunks
+     * across the reset: anything queued before this configure call is
+     * about to be drained into the new filter below. */
     for (int i = 0; i < nb_bindings; i++) {
         bindings[i].flt_ctx = NULL;
         bindings[i].dec_ctx = NULL;
@@ -190,33 +298,89 @@
