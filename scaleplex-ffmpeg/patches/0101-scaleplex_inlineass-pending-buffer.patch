 }
 
+/* Forward decl — process_header is defined further below and is also
+ * called from avfilter_inlineass_replay_chunk just above append_data. */
+static void process_header(AVFilterContext *link, AVCodecContext *dec_ctx);
+
+/* scaleplex: side-channel replay used by scaleplex_inlineass.c to flush
+ * subtitle chunks that were buffered before configure_filtergraph set
+ * flt_ctx on the binding. Pre-decoded (start_ms, duration_ms, ass_line)
+ * tuples skip avsubtitle reconstruction; we still need dec_ctx for the
+ * first-call process_header on the track. Holds the same global lock
+ * as append_data so concurrent filter_frame on the filter thread can't
+ * race. */
+void avfilter_inlineass_replay_chunk(AVFilterContext *link, AVCodecContext *dec_ctx,
+                                     int64_t start_ms, int64_t duration_ms,
+                                     const char *ass_line)
+{
+    AssContext *ass;
+
+    if (!link || !link->priv || !ass_line)
+        return;
+    ass = link->priv;
+
+    pthread_mutex_lock(&inlineass_lock);
+    if (!ass->got_header && dec_ctx)
+        process_header(link, dec_ctx);
+    if (ass->track) {
+        av_log(link, AV_LOG_VERBOSE,
+               "scaleplex_inlineass: replay_chunk start=%" PRId64 " dur=%" PRId64 " line=\"%.60s\"\n",
+               start_ms, duration_ms, ass_line);
+        ass_process_chunk(ass->track, ass_line, strlen(ass_line),
+                          start_ms, duration_ms);
+    }
+    pthread_mutex_unlock(&inlineass_lock);
+}
+
 /* Caller (avfilter_inlineass_append_data) holds inlineass_lock — every
  * libass call below runs under that lock. */
 static void process_header(AVFilterContext *link, AVCodecContext *dec_ctx)
