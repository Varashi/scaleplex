+            ass->ow / 2, ass->oh / 2,
+            (CUdeviceptr)ass->cuda_overlay->data[3], ass->cuda_overlay->linesize[3], 2, 2,
+            0 /* need_unpremul */, 0 /* overlay_full (unused) */);
+        /* V */
+        inlineass_cuda_call_kernel(avctx,
+            x_pos / 2, y_pos / 2,
+            (CUdeviceptr)input->data[plane_v], input->linesize[plane_v],
+            input->width / 2, input->height / 2,
+            main_adj_x, 1,
+            ass->cuda_main_desc->comp[plane_v].depth, ass->cuda_main_desc->comp[plane_v].shift,
+            (CUdeviceptr)ass->cuda_overlay->data[2], ass->cuda_overlay->linesize[2],
+            ass->ow / 2, ass->oh / 2,
+            (CUdeviceptr)ass->cuda_overlay->data[3], ass->cuda_overlay->linesize[3], 2, 2,
+            0 /* need_unpremul */, 0 /* overlay_full (unused) */);
+    }
+
+    INLINEASS_CUDA_CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+
+    return ff_filter_frame(outlink, input);
+
+fail:
+    av_frame_free(&input);
+    return err;
+}
+#endif /* CONFIG_OVERLAY_CUDA_FILTER */
