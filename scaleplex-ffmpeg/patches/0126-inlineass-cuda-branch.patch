+/*
+ * scaleplex: alpha-blend kernel for the vf_inlineass CUDA branch.
+ *
+ * Derived from vf_overlay_cuda.cu's overlay_func (same fork), but the overlay
+ * (subtitle band, rendered by libass at render_height) and its alpha are read
+ * through CUDA TEXTURE OBJECTS with normalized coordinates + hardware bilinear
+ * filtering. That folds the render->full upscale into the blend (free HW
+ * bilinear), so the overlay surface stays small (render dims) and there is no
+ * per-frame CPU swscale upscale — the cost that hurt animated ASS (scaleplex
+ * #107, follow-up to #76).
+ *
+ * Both textures are UNSIGNED_INT8, sampled as float (LINEAR filter => values
+ * normalized to [0,1]); overlay luma/chroma scaled back to 8-bit, alpha used
+ * directly. Normalized coords (u,v)=((x+0.5)/out_w,(y+0.5)/out_h) address the
+ * same [0,1] canvas for every plane regardless of its resolution, so the same
+ * (u,v) samples the correct overlay + alpha for Y and the subsampled U/V.
+ *
+ * main is the video frame, blended IN PLACE: NV12 (uchar) or P010/P016
+ * (ushort) semi-planar via main_adj_x / main_offset / main_depth / main_shift.
+ * Straight-alpha source-over (no unpremultiply).
+ */
+
+template<typename T0>
+__inline__ __device__ void inlineass_overlay_tex(
+    T0* main, int main_linesize,
+    int main_adj_x, int main_offset,
+    int main_depth, int main_shift,
+    cudaTextureObject_t overlay_tex, cudaTextureObject_t alpha_tex,
+    int out_w, int out_h)
+{
+    int x = blockIdx.x * blockDim.x + threadIdx.x;
+    int y = blockIdx.y * blockDim.y + threadIdx.y;
+
+    if (x >= out_w || y >= out_h)
+        return;
+
+    float u = (x + 0.5f) / (float)out_w;
+    float v = (y + 0.5f) / (float)out_h;
+
+    float alpha = tex2D<float>(alpha_tex, u, v);   /* [0,1] */
+    if (alpha <= 0.0f)
+        return;                                    /* fully transparent -> leave main */
+
+    float overlay = tex2D<float>(overlay_tex, u, v) * 255.0f;
+
+    int main_pos = main_adj_x * x + y * (main_linesize / (int)sizeof(*main))
+                   + (main_adj_x > 1 ? main_offset : 0);
+
+    if (main_depth > 8) {
+        T0 overlay_res = (T0)(alpha * overlay) << (main_depth - 8);
+        T0 main_res    = (T0)((1.0f - alpha) * (main[main_pos] >> main_shift));
+        main[main_pos] = (T0)(overlay_res + main_res) << main_shift;
+    } else {
+        main[main_pos] = (T0)(alpha * overlay + (1.0f - alpha) * main[main_pos]);
+    }
+}
+
+extern "C" {
+
+__global__ void Inlineass_Cuda_tex_uchar(
+    unsigned char* main, int main_linesize,
+    int main_adj_x, int main_offset,
+    int main_depth, int main_shift,
+    cudaTextureObject_t overlay_tex, cudaTextureObject_t alpha_tex,
+    int out_w, int out_h)
+{
+    inlineass_overlay_tex<unsigned char>(
+        main, main_linesize, main_adj_x, main_offset, main_depth, main_shift,
+        overlay_tex, alpha_tex, out_w, out_h);
+}
+
+__global__ void Inlineass_Cuda_tex_ushort(
+    unsigned short* main, int main_linesize,
+    int main_adj_x, int main_offset,
+    int main_depth, int main_shift,
+    cudaTextureObject_t overlay_tex, cudaTextureObject_t alpha_tex,
+    int out_w, int out_h)
+{
+    inlineass_overlay_tex<unsigned short>(
+        main, main_linesize, main_adj_x, main_offset, main_depth, main_shift,
+        overlay_tex, alpha_tex, out_w, out_h);
+}
+
