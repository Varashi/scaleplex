+        INLINEASS_CUDA_CHECK_CU(cu->cuModuleUnload(ass->cu_module));
+        INLINEASS_CUDA_CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        ass->cu_module = NULL;
+    }
+    av_frame_free(&ass->cuda_overlay);
+    av_frame_free(&ass->cuda_cpu);
+    av_buffer_unref(&ass->cuda_overlay_frames_ref);
+    av_freep(&ass->cuda_rgba);
+    sws_freeContext(ass->cuda_sws);
+    ass->cuda_sws   = NULL;
+    ass->cuda_hwctx = NULL;
+#endif /* CONFIG_OVERLAY_CUDA_FILTER */
