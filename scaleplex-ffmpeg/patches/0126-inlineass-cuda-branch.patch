+/* ======================================================================== *
+ *  HW (CUDA) branch — GPU-resident text/ASS burn-in (issue #76).            *
+ *  Mirrors the VAAPI branch: render-once-per-cue + cached overlay surface,  *
+ *  blended onto each video frame by the Inlineass_Cuda_* kernel. All libass *
+ *  call sites run under inlineass_lock (shared with SW/VAAPI + fftools).    *
+ * ======================================================================== */
+
+static int inlineass_cuda_create_overlay(AVFilterContext *avctx);   /* fwd */
+
+/* Composite the libass image list into the (cleared) STRAIGHT-alpha RGBA
+ * staging buffer. Plain source-over with per-pixel alpha; the result is NOT
+ * premultiplied, so the CUDA blend kernel runs with need_unpremul = 0.
+ * libass color is RRGGBBTT (TT = transparency, opacity = 255-TT). Layout is
+ * R,G,B,A bytes to match AV_PIX_FMT_RGBA fed to swscale. */
+static void render_ass_images_rgba_straight(uint8_t *buf, int stride,
+                                            int w, int h, const ASS_Image *img)
+{
+    for (; img; img = img->next) {
+        int rr = (img->color >> 24) & 0xFF;
+        int gg = (img->color >> 16) & 0xFF;
+        int bb = (img->color >>  8) & 0xFF;
+        int op = 255 - (img->color & 0xFF);   /* cue opacity */
+        int y, x;
+        if (op == 0)
+            continue;
+        for (y = 0; y < img->h; y++) {
+            int dy = img->dst_y + y;
+            const uint8_t *src;
+            uint8_t *dst;
+            if (dy < 0 || dy >= h)
+                continue;
+            src = img->bitmap + (ptrdiff_t)y * img->stride;
+            dst = buf + (ptrdiff_t)dy * stride;
+            for (x = 0; x < img->w; x++) {
+                int dx = img->dst_x + x;
+                int a, ia, na;
+                uint8_t *p;
+                if (dx < 0 || dx >= w)
+                    continue;
+                a = op * src[x] / 255;          /* src alpha 0..255 */
+                if (a == 0)
+                    continue;
+                ia = 255 - a;
+                p = dst + (ptrdiff_t)dx * 4;     /* RGBA, straight (un-premult) */
+                /* Straight-alpha source-over: out = (src*a + dst*da*(1-a)) / outA.
+                 * dst alpha (p[3]) and color are already straight. */
+                na = a + p[3] * ia / 255;        /* resulting alpha 0..255 */
+                if (na <= 0) {
+                    p[0] = p[1] = p[2] = p[3] = 0;
+                    continue;
+                }
+                p[0] = (rr * a + p[0] * p[3] * ia / 255) / na;
+                p[1] = (gg * a + p[1] * p[3] * ia / 255) / na;
+                p[2] = (bb * a + p[2] * p[3] * ia / 255) / na;
+                p[3] = na;
+            }
+        }
+    }
+}
+
+/* Get the AVCUDADeviceContext from the input hw_frames_ctx and load the blend
+ * module + the uchar/ushort kernel functions. Filter thread; called once from
+ * config_output when the negotiated format is CUDA. */
+static int inlineass_cuda_init_module(AVFilterContext *avctx)
+{
+    AssContext           *ass    = avctx->priv;
+    AVFilterLink         *inlink = avctx->inputs[0];
+    FilterLink           *inl    = ff_filter_link(inlink);
+    AVHWFramesContext    *in_frames_ctx;
+    AVCUDADeviceContext  *hwctx;
+    CudaFunctions        *cu;
+    CUcontext             dummy;
+    int                   err;
+
+    extern const unsigned char ff_vf_inlineass_cuda_ptx_data[];
+    extern const unsigned int  ff_vf_inlineass_cuda_ptx_len;
+
+    if (!inl->hw_frames_ctx) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(cuda): no hw context on input\n");
+        return AVERROR(EINVAL);
+    }
+    in_frames_ctx = (AVHWFramesContext *)inl->hw_frames_ctx->data;
+
+    ass->cuda_main_sw_fmt = in_frames_ctx->sw_format;
+    ass->cuda_main_desc   = av_pix_fmt_desc_get(ass->cuda_main_sw_fmt);
+    if (!ass->cuda_main_desc) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(cuda): unknown main sw_format %d\n",
+               ass->cuda_main_sw_fmt);
+        return AVERROR(EINVAL);
+    }
+
+    ass->cuda_hwctx = in_frames_ctx->device_ctx->hwctx;
+    hwctx           = ass->cuda_hwctx;
+    ass->cu_stream  = hwctx->stream;
+    cu              = hwctx->internal->cuda_dl;
+
+    err = INLINEASS_CUDA_CHECK_CU(cu->cuCtxPushCurrent(hwctx->cuda_ctx));
+    if (err < 0)
+        return err;
+
+    err = ff_cuda_load_module(avctx, hwctx, &ass->cu_module,
+                              ff_vf_inlineass_cuda_ptx_data,
+                              ff_vf_inlineass_cuda_ptx_len);
+    if (err < 0)
+        goto exit;
+
+    err = INLINEASS_CUDA_CHECK_CU(cu->cuModuleGetFunction(&ass->cu_func_uchar,
+                                  ass->cu_module, "Inlineass_Cuda_uchar"));
+    if (err < 0)
+        goto exit;
+
+    err = INLINEASS_CUDA_CHECK_CU(cu->cuModuleGetFunction(&ass->cu_func_ushort,
+                                  ass->cu_module, "Inlineass_Cuda_ushort"));
+    if (err < 0)
+        goto exit;
+
+exit:
+    INLINEASS_CUDA_CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    return err;
+}
+
+/* Allocate the cached CUDA overlay surface (YUVA420P) sized to the band
+ * (ow x oh) + the CPU YUVA420P staging frame + the straight-RGBA libass
+ * render buffer + the RGBA->YUVA420P swscale converter. Mirrors
+ * inlineass_create_overlay (VAAPI). Filter thread. */
+static int inlineass_cuda_create_overlay(AVFilterContext *avctx)
+{
+    AssContext        *ass = avctx->priv;
+    AVHWFramesContext *frames;
+    AVBufferRef       *device_ref;
+    int                err;
+
+    if (!ass->cuda_hwctx) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(cuda): module not initialised\n");
+        return AVERROR(EINVAL);
+    }
+
+    /* device_ref: re-derive from the input frames ctx (same device the module
+     * was loaded on). */
+    {
+        AVFilterLink *inlink = avctx->inputs[0];
+        FilterLink   *inl    = ff_filter_link(inlink);
+        AVHWFramesContext *in_frames_ctx;
+        if (!inl->hw_frames_ctx)
+            return AVERROR(EINVAL);
+        in_frames_ctx = (AVHWFramesContext *)inl->hw_frames_ctx->data;
+        device_ref    = in_frames_ctx->device_ref;
+    }
+
+    ass->cuda_overlay_frames_ref = av_hwframe_ctx_alloc(device_ref);
+    if (!ass->cuda_overlay_frames_ref)
+        return AVERROR(ENOMEM);
+    frames = (AVHWFramesContext *)ass->cuda_overlay_frames_ref->data;
+    frames->format            = AV_PIX_FMT_CUDA;
+    frames->sw_format         = AV_PIX_FMT_YUVA420P;
+    frames->width             = ass->ow;
+    frames->height            = ass->oh;
+    frames->initial_pool_size = 1;
+    err = av_hwframe_ctx_init(ass->cuda_overlay_frames_ref);
+    if (err < 0) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(cuda): init overlay frames ctx: %d.\n", err);
+        return err;
+    }
+
+    ass->cuda_overlay = av_frame_alloc();
+    if (!ass->cuda_overlay)
+        return AVERROR(ENOMEM);
+    err = av_hwframe_get_buffer(ass->cuda_overlay_frames_ref, ass->cuda_overlay, 0);
+    if (err < 0)
+        return err;
+
+    ass->cuda_cpu = av_frame_alloc();
+    if (!ass->cuda_cpu)
+        return AVERROR(ENOMEM);
+    ass->cuda_cpu->format = AV_PIX_FMT_YUVA420P;
+    ass->cuda_cpu->width  = ass->ow;
+    ass->cuda_cpu->height = ass->oh;
+    /* LIMITED (MPEG/TV) range to match a typical decoded NV12/P010 main frame.
+     * Because we blend with need_unpremul = 0, the kernel never applies its
+     * overlay_full offset — the alpha blend uses the swscale Y/U/V verbatim,
+     * so the output range MUST match the main frame's encoding range. Limited
+     * is the safe default for decoded video.
+     * TODO(verify): if the negotiated main frame is full-range (rare for
+     * NVDEC output) the burned text luma/chroma will be slightly off. A
+     * follow-up could read inlink frame->color_range at first frame and pick
+     * the swscale dst range accordingly. */
+    ass->cuda_cpu->color_range = AVCOL_RANGE_MPEG;
+    err = av_frame_get_buffer(ass->cuda_cpu, 0);
+    if (err < 0)
+        return err;
+
+    /* RGBA libass buffer sized to the REDUCED render dims; swscale upscales it
+     * to the FULL-frame YUVA cpu staging below. */
+    ass->cuda_rgba_stride = ass->cuda_render_w * 4;
+    av_freep(&ass->cuda_rgba);
+    ass->cuda_rgba = av_mallocz((size_t)ass->cuda_rgba_stride * ass->cuda_render_h);
+    if (!ass->cuda_rgba)
+        return AVERROR(ENOMEM);
+
+    /* src = render dims (small), dst = full frame (ow x oh): swscale upscales.
+     * SWS_BILINEAR matches the VAAPI VPP upscale (smooth, not nearest-neighbour
+     * SWS_POINT which would alias the now-upscaled overlay). */
+    sws_freeContext(ass->cuda_sws);
+    ass->cuda_sws = sws_getContext(ass->cuda_render_w, ass->cuda_render_h, AV_PIX_FMT_RGBA,
+                                   ass->ow, ass->oh, AV_PIX_FMT_YUVA420P,
+                                   SWS_BILINEAR, NULL, NULL, NULL);
+    if (!ass->cuda_sws) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(cuda): sws_getContext failed\n");
+        return AVERROR(EINVAL);
+    }
+    /* RGB in = full range; YUV out = limited (BT.601 coeffs, matches FFDraw's
+     * default in the SW branch). */
+    {
+        const int *inv = sws_getCoefficients(SWS_CS_ITU601);
+        sws_setColorspaceDetails(ass->cuda_sws,
+                                 inv, 1 /* srcRange: RGB is full */,
+                                 inv, 0 /* dstRange: YUV limited */,
+                                 0, 1 << 16, 1 << 16);
+    }
+
+    ass->cuda_have_overlay = 0;
+    return 0;
+}
+
+/* Render the cue active at time_ms; on change, re-rasterise (straight RGBA),
+ * swscale to YUVA420P, and re-upload the cached CUDA overlay surface. Sets
+ * cuda_have_overlay = whether a cue is visible. Mirrors refresh_overlay. */
+static int inlineass_cuda_refresh_overlay(AVFilterContext *avctx, int64_t time_ms)
+{
+    AssContext *ass = avctx->priv;
+    int         change = 0, err = 0, do_upload = 0, clear = 0;
+    ASS_Image  *img;
+
+    pthread_mutex_lock(&inlineass_lock);
+    /* libass rasterises into the REDUCED render canvas (cuda_render_w/h);
+     * swscale upscales to the full-frame YUVA below. The animated-tier-down
+     * mechanism (VAAPI-only) does not apply on CUDA; animated cues simply
+     * re-render every frame at the (capped) render res, same shape as the SW
+     * branch but cheaper. */
+    img = ass_render_frame(ass->renderer, ass->track, time_ms, &change);
+    if (change) {
+        if (!img) {
+            clear = 1;
+        } else {
+            memset(ass->cuda_rgba, 0,
+                   (size_t)ass->cuda_rgba_stride * ass->cuda_render_h);
+            render_ass_images_rgba_straight(ass->cuda_rgba, ass->cuda_rgba_stride,
+                                            ass->cuda_render_w, ass->cuda_render_h, img);
+            do_upload = 1;
+        }
+    }
+    pthread_mutex_unlock(&inlineass_lock);
+
+    if (clear) {
+        ass->cuda_have_overlay = 0;
+        return 0;
+    }
+    if (do_upload) {
+        const uint8_t *src_data[4] = { ass->cuda_rgba, NULL, NULL, NULL };
+        const int      src_stride[4] = { ass->cuda_rgba_stride, 0, 0, 0 };
+        /* srcSliceH = full SOURCE (render) height; swscale upscales and emits
+         * the full DESTINATION height (ass->oh), which is what it returns. */
+        int h = sws_scale(ass->cuda_sws, src_data, src_stride, 0, ass->cuda_render_h,
+                          ass->cuda_cpu->data, ass->cuda_cpu->linesize);
+        if (h != ass->oh) {
+            av_log(avctx, AV_LOG_ERROR, "inlineass(cuda): sws_scale returned %d (want %d)\n",
+                   h, ass->oh);
+            return AVERROR(EINVAL);
+        }
+        err = av_hwframe_transfer_data(ass->cuda_overlay, ass->cuda_cpu, 0);
+        if (err < 0) {
+            av_log(avctx, AV_LOG_ERROR, "inlineass(cuda): upload overlay surface: %d.\n", err);
+            return err;
+        }
+        ass->cuda_have_overlay = 1;
+    }
+    return 0;
+}
+
+/* Launch the blend kernel for one plane. Mirrors overlay_cuda_call_kernel:
+ * the kernel selects uchar vs ushort by main_depth (DEPTH_BYTES). The overlay
+ * is planar YUVA420P (data[0..2] Y/U/V, data[3] alpha). */
+static int inlineass_cuda_call_kernel(AVFilterContext *avctx,
+    int x_position, int y_position,
+    CUdeviceptr main_data, int main_linesize,
+    int main_width, int main_height,
+    int main_adj_x, int main_offset, int main_depth, int main_shift,
+    CUdeviceptr overlay_data, int overlay_linesize,
+    int overlay_width, int overlay_height,
+    CUdeviceptr alpha_data, int alpha_linesize,
+    int alpha_adj_x, int alpha_adj_y,
+    int need_unpremul, int overlay_full)
+{
+    AssContext          *ass   = avctx->priv;
+    AVCUDADeviceContext *hwctx = ass->cuda_hwctx;
+    CudaFunctions       *cu    = hwctx->internal->cuda_dl;
+
+    void *kernel_args[] = {
+        &x_position, &y_position,
+        &main_data, &main_linesize,
+        &main_adj_x, &main_offset,
+        &main_depth, &main_shift,
+        &overlay_data, &overlay_linesize,
+        &overlay_width, &overlay_height,
+        &alpha_data, &alpha_linesize,
+        &alpha_adj_x, &alpha_adj_y,
+        &need_unpremul, &overlay_full,
+    };
+
+#define INLINEASS_CUDA_DEPTH_BYTES(depth) (((depth) + 7) / 8)
+
+    return INLINEASS_CUDA_CHECK_CU(cu->cuLaunchKernel(
+        INLINEASS_CUDA_DEPTH_BYTES(main_depth) == 1 ? ass->cu_func_uchar
+                                                     : ass->cu_func_ushort,
+        INLINEASS_CUDA_DIV_UP(main_width, INLINEASS_CUDA_BLOCK_X),
+        INLINEASS_CUDA_DIV_UP(main_height, INLINEASS_CUDA_BLOCK_Y), 1,
+        INLINEASS_CUDA_BLOCK_X, INLINEASS_CUDA_BLOCK_Y, 1,
+        0, ass->cu_stream, kernel_args, NULL));
+}
+
+/* HW (CUDA) per-frame composite: refresh the cached overlay, then blend it
+ * onto the input video frame IN PLACE (Y plane then U/V), and forward. The
+ * input carries the scaled/tonemapped picture; output == input. Single input
+ * → no framesync. Bitmap (PGS) subs are out of scope on CUDA. */
+static int filter_frame_cuda(AVFilterLink *inlink, AVFrame *input)
+{
+    AVFilterContext     *avctx   = inlink->dst;
+    AVFilterLink        *outlink = avctx->outputs[0];
+    AssContext          *ass     = avctx->priv;
+    AVCUDADeviceContext *hwctx   = ass->cuda_hwctx;
+    CudaFunctions       *cu;
+    CUcontext            dummy;
+    int64_t              time_ms;
+    int                  err;
+    int                  is_main_semi, main_adj_x;
+    int                  x_pos, y_pos;
+
+    if (!hwctx) {
+        err = AVERROR(EINVAL);
+        goto fail;
+    }
+    cu = hwctx->internal->cuda_dl;
+
+    time_ms = av_rescale_q(input->pts, inlink->time_base, ASS_TIME_BASE);
+    err = inlineass_cuda_refresh_overlay(avctx, time_ms);
+    if (err < 0)
+        goto fail;
+
+    /* No visible cue → pass the frame straight through (blend in place means
+     * the input pool == output pool, so this is safe, unlike the VAAPI VPP
+     * path which must always render to its own output pool). */
+    if (!ass->cuda_have_overlay)
+        return ff_filter_frame(outlink, input);
+
+    err = ff_inlink_make_frame_writable(inlink, &input);
+    if (err < 0)
+        goto fail;
+
+    /* The overlay is rendered at full frame size (see config_output), so it
+     * is blended at the origin with no offset. libass already positioned the
+     * cue within the full canvas. */
+    x_pos = 0;
+    y_pos = 0;
+
+    err = INLINEASS_CUDA_CHECK_CU(cu->cuCtxPushCurrent(hwctx->cuda_ctx));
+    if (err < 0)
+        goto fail;
+
+    is_main_semi = ass->cuda_main_sw_fmt == AV_PIX_FMT_NV12 ||
+                   ass->cuda_main_sw_fmt == AV_PIX_FMT_P010 ||
+                   ass->cuda_main_sw_fmt == AV_PIX_FMT_P016;
+
+    /* Y plane: main_adj_x = 1, offset 0. Overlay Y = data[0], alpha = data[3]. */
+    inlineass_cuda_call_kernel(avctx,
+        x_pos, y_pos,
+        (CUdeviceptr)input->data[0], input->linesize[0],
+        input->width, input->height,
+        1, 0,
