+    if (ass->amd_active)
+        return inlineass_amd_vk_config(avctx, inlink);
+#endif
+
     /* HW (VAAPI) branch. */
     outlink->time_base     = inlink->time_base;
     vpp_ctx->output_width  = inlink->w;
@@ -2345,8 +2960,13 @@ static int filter_frame(AVFilterLink *inlink, AVFrame *picref)
     long long time_ms;
     int err;
 
-    if (inlink->format == AV_PIX_FMT_VAAPI)
