 } AssContext;
 
 /* scaleplex: process-wide libass lock. libass is not reentrant across
@@ -1465,6 +1565,733 @@ fail:
 }
 #endif /* CONFIG_OVERLAY_CUDA_FILTER */
 
+#if CONFIG_LIBPLACEBO_FILTER
+/* ======================================================================== *
+ *  HW (AMD-Vulkan) branch — sub-burn via libplacebo pl_render_image +      *
+ *  pl_overlay. Mirrors mpv vo_gpu_next update_overlays(). Active only when *
+ *  input is AV_PIX_FMT_VAAPI AND vendor probe matches "Mesa" (radeonsi).   *
+ *  Issue #123, patch 0127.                                                  *
+ * ======================================================================== */
+
+/* libplacebo log → ffmpeg log bridge (per-instance, avctx in log_priv). */
+static void inlineass_amd_pl_log_cb(void *log_priv, enum pl_log_level level,
+                                    const char *msg)
+{
+    AVFilterContext *avctx = log_priv;
+    int av_level = AV_LOG_VERBOSE;
+    switch (level) {
+    case PL_LOG_FATAL:
+    case PL_LOG_ERR:   av_level = AV_LOG_ERROR;   break;
+    case PL_LOG_WARN:  av_level = AV_LOG_WARNING; break;
+    case PL_LOG_INFO:  av_level = AV_LOG_INFO;    break;
+    case PL_LOG_DEBUG: av_level = AV_LOG_DEBUG;   break;
+    default:           av_level = AV_LOG_VERBOSE; break;
+    }
+    av_log(avctx, av_level, "libplacebo: %s\n", msg);
+}
+
+/* lock_queue / unlock_queue thunks bridging AVVulkanDeviceContext's per-queue
+ * lock callbacks to libplacebo's pl_vulkan_import_params signature. Cribbed
+ * verbatim from vf_libplacebo.c's lock_queue/unlock_queue + init_vulkan() —
+ * priv == AVHWDeviceContext*, hwctx->lock_queue takes (avhwctx, qf, idx). */
+static void inlineass_amd_lock_queue(void *priv, uint32_t qf, uint32_t qidx)
+{
+    AVHWDeviceContext *avhwctx = priv;
+    const AVVulkanDeviceContext *hwctx = avhwctx->hwctx;
+    hwctx->lock_queue(avhwctx, qf, qidx);
+}
+
+static void inlineass_amd_unlock_queue(void *priv, uint32_t qf, uint32_t qidx)
+{
+    AVHWDeviceContext *avhwctx = priv;
+    const AVVulkanDeviceContext *hwctx = avhwctx->hwctx;
+    hwctx->unlock_queue(avhwctx, qf, qidx);
+}
+
+/* Probe the input VAAPI device's vendor string. Returns 1 iff this filter
+ * should take the AMD-Vulkan branch (vendor contains "Mesa", i.e. radeonsi).
+ * Called once at config_input time; result cached on ass->amd_active.
+ *
+ * TODO(amd-vk-validate): Mesa-on-Intel (iris/crocus) would also match "Mesa"
+ * — all scaleplex Intel deployments use the iHD binary driver, but a
+ * Mesa-iris reporter would mis-route here. Defensive: ?cross-check
+ * vendor_id from sysfs DRM node, or accept the env-var override the worker
+ * already computes via detectVAAPIDriver. */
+static int inlineass_amd_vendor_is_mesa(AVFilterContext *avctx, AVFilterLink *inlink)
+{
+    /* ffmpeg 7 moved hw_frames_ctx off AVFilterLink onto the internal
+     * FilterLink (accessed via ff_filter_link). vf_libplacebo uses the
+     * same accessor (see its input_init / map_frame). */
+    FilterLink            *il = ff_filter_link(inlink);
+    AVHWFramesContext     *frames;
+    AVHWDeviceContext     *device;
+    AVVAAPIDeviceContext  *vactx;
+    const char            *vendor;
+
+    if (!il->hw_frames_ctx)
+        return 0;
+    frames = (AVHWFramesContext *)il->hw_frames_ctx->data;
+    if (!frames || !frames->device_ref)
+        return 0;
+    device = (AVHWDeviceContext *)frames->device_ref->data;
+    vactx  = device->hwctx;
+    vendor = vaQueryVendorString(vactx->display);
+    if (!vendor)
+        return 0;
+    av_log(avctx, AV_LOG_VERBOSE, "inlineass(amd-vk): VAAPI vendor = \"%s\"\n", vendor);
+    return strstr(vendor, "Mesa") != NULL;
+}
+
+/* config_output for the AMD-Vulkan branch. Called from config_output when
+ * ass->amd_active was latched in config_input. Derives a Vulkan
+ * AVHWDeviceContext from the input VAAPI device (via DRM intermediary —
+ * direct VAAPI→Vulkan derive is broken on jellyfin-ffmpeg7), imports it into
+ * libplacebo, creates the renderer, and sets the output link geometry +
+ * frames-ctx (we keep AV_PIX_FMT_VAAPI throughout and allocate output
+ * surfaces from the same input pool). */
+static int inlineass_amd_vk_config(AVFilterContext *avctx, AVFilterLink *inlink)
+{
+    AssContext        *ass     = avctx->priv;
+    AVFilterLink      *outlink = avctx->outputs[0];
+    AVHWFramesContext *in_frames;
+    AVBufferRef       *drm_ref = NULL;
+    AVHWDeviceContext *vk_device;
+    AVVulkanDeviceContext *vkctx;
+    FilterLink        *il, *ol;
+    int ret;
+
+    il = ff_filter_link(inlink);
+    if (!il->hw_frames_ctx) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): no hw_frames_ctx on input\n");
+        return AVERROR(EINVAL);
+    }
+    in_frames = (AVHWFramesContext *)il->hw_frames_ctx->data;
+
+    /* VAAPI → DRM → Vulkan derive chain. ffmpeg handles DMA-BUF export
+     * + Vulkan import for us. */
+    ret = av_hwdevice_ctx_create_derived(&drm_ref, AV_HWDEVICE_TYPE_DRM,
+                                         in_frames->device_ref, 0);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_ERROR,
+               "inlineass(amd-vk): derive DRM device failed: %s\n", av_err2str(ret));
+        return ret;
+    }
+    ret = av_hwdevice_ctx_create_derived(&ass->amd_vk_device_ref,
+                                         AV_HWDEVICE_TYPE_VULKAN, drm_ref, 0);
+    av_buffer_unref(&drm_ref);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_ERROR,
+               "inlineass(amd-vk): derive Vulkan device failed: %s\n", av_err2str(ret));
+        return ret;
+    }
+
+    vk_device = (AVHWDeviceContext *)ass->amd_vk_device_ref->data;
+    vkctx     = vk_device->hwctx;
+
+    ass->amd_pl_log = pl_log_create(PL_API_VER, pl_log_params(
+        .log_cb    = inlineass_amd_pl_log_cb,
+        .log_priv  = avctx,
+        .log_level = PL_LOG_WARN,
+    ));
+    if (!ass->amd_pl_log) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): pl_log_create failed\n");
+        return AVERROR(ENOMEM);
+    }
+
+    /* Import the AVF Vulkan device into libplacebo. Field+queue mapping
+     * cribbed verbatim from vf_libplacebo.c init_vulkan() (PL_API_VER>=278
+     * branch — guaranteed by CONFIG_LIBPLACEBO_FILTER gating).  */
+    ass->amd_pl_vk = pl_vulkan_import(ass->amd_pl_log, pl_vulkan_import_params(
+        .instance        = vkctx->inst,
+        .get_proc_addr   = vkctx->get_proc_addr,
+        .phys_device     = vkctx->phys_dev,
+        .device          = vkctx->act_dev,
+        .extensions      = vkctx->enabled_dev_extensions,
+        .num_extensions  = vkctx->nb_enabled_dev_extensions,
+        .features        = &vkctx->device_features,
+        .lock_queue      = inlineass_amd_lock_queue,
+        .unlock_queue    = inlineass_amd_unlock_queue,
+        .queue_ctx       = vk_device,
+        .queue_graphics  = {
+            .index = vkctx->queue_family_index,
+            .count = vkctx->nb_graphics_queues,
+        },
+        .queue_compute   = {
+            .index = vkctx->queue_family_comp_index,
+            .count = vkctx->nb_comp_queues,
+        },
+        .queue_transfer  = {
+            .index = vkctx->queue_family_tx_index,
+            .count = vkctx->nb_tx_queues,
+        },
+        .max_api_version = VK_API_VERSION_1_3,
+    ));
+    if (!ass->amd_pl_vk) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): pl_vulkan_import failed\n");
+        return AVERROR(EIO);
+    }
+
+    ass->amd_pl_rr = pl_renderer_create(ass->amd_pl_log, ass->amd_pl_vk->gpu);
+    if (!ass->amd_pl_rr) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): pl_renderer_create failed\n");
+        return AVERROR(ENOMEM);
+    }
+
+    /* Intermediate Vulkan AVHWFramesContext — the RENDER TARGET pool.
+     * libplacebo's pl_map_avframe_ex on a VAAPI input goes via
+     * pl_map_avframe_drm, which hard-codes the imported pl_tex as
+     * sampleable + blit_src only (never renderable) — VAAPI surfaces
+     * lack VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT on the Vulkan side and
+     * there's no AVVAAPIFramesContext knob to add it. Workaround
+     * (mirrors vf_libplacebo's Vulkan-output path): render into a
+     * Vulkan-native AVFrame allocated from THIS pool (vkfc->usage |=
+     * COLOR_ATTACHMENT_BIT → pl_map_avframe_vulkan passes the flag to
+     * pl_vulkan_wrap → the pl_tex IS renderable), then DMA-BUF
+     * map the Vulkan frame to a VAAPI AVFrame for the downstream
+     * encoder via vulkan_map_to_vaapi (zero GPU-side copy; the same
+     * dma-buf the Vulkan render wrote into becomes the VAAPI surface).
+     * DRM_FORMAT_MODIFIER_EXT tiling is required so the underlying
+     * VkImage is dma-buf exportable for that map step. */
+    {
+        AVHWFramesContext     *vk_frames;
+        AVVulkanFramesContext *vk_hwctx;
+        /* scaleplex (patch 0127 v7, issue #137): output sw_format is nv12
+         * (SDR 8-bit) ONLY when the rewriter signalled HDR→SDR intent via
+         * hdr_to_sdr=1 AND the input is HDR — libplacebo will tonemap in
+         * filter_frame_amd_vk (pl_tgt.color = pl_color_space_bt709 override,
+         * also gated on hdr_to_sdr). For HDR-passthrough (hdr_to_sdr=0 +
+         * HDR source) and any SDR source, the pool mirrors the input pool's
+         * sw_format — no format conversion, no extra Vulkan→VAAPI realloc
+         * (passthrough hits the input-pool-reuse branch below). */
+        enum AVPixelFormat out_swfmt = in_frames->sw_format;
+        if (ass->hdr_to_sdr &&
+            (in_frames->sw_format == AV_PIX_FMT_P010 ||
+             in_frames->sw_format == AV_PIX_FMT_P012 ||
+             in_frames->sw_format == AV_PIX_FMT_P016)) {
+            out_swfmt = AV_PIX_FMT_NV12;
+        }
+
+        ass->amd_vk_frames_ref = av_hwframe_ctx_alloc(ass->amd_vk_device_ref);
+        if (!ass->amd_vk_frames_ref)
+            return AVERROR(ENOMEM);
+        vk_frames                    = (AVHWFramesContext *)ass->amd_vk_frames_ref->data;
+        vk_frames->format            = AV_PIX_FMT_VULKAN;
+        vk_frames->sw_format         = out_swfmt;
+        vk_frames->width             = inlink->w;
+        vk_frames->height            = inlink->h;
+        vk_frames->initial_pool_size = 4; /* small ring: encoder retires 1-2 in flight */
+
+        vk_hwctx = vk_frames->hwctx;
+        /* SAMPLED + TRANSFER bits are added automatically by
+         * hwcontext_vulkan (see header doc on `usage`). */
+        vk_hwctx->usage  = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+
+        /* DRM_FORMAT_MODIFIER_EXT tiling requires a modifier list in pNext —
+         * hwcontext_vulkan.c forwards VkImageCreateInfo straight to
+         * vkCreateImage with create_pnext as the pNext chain, no
+         * auto-discovery. Without this RADV null-derefs at [r14+0x10]
+         * picking a modifier (v2 SIGSEGV). LINEAR is the safe minimum:
+         * universally supported, dma-buf-exportable, trivially importable
+         * back into VAAPI for the downstream encoder.
+         * TODO(amd-vk-v3a:probe): probe RADV's supported tiled modifiers
+         * via vkGetPhysicalDeviceFormatProperties2 +
+         * VkDrmFormatModifierPropertiesList2EXT for a perf bump (DCC, etc.). */
+        ass->amd_vk_mod_list[0]                       = DRM_FORMAT_MOD_LINEAR;
+        ass->amd_vk_mod_list_info.sType               = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT;
+        ass->amd_vk_mod_list_info.pNext               = NULL;
+        ass->amd_vk_mod_list_info.drmFormatModifierCount = 1;
+        ass->amd_vk_mod_list_info.pDrmFormatModifiers = ass->amd_vk_mod_list;
+        vk_hwctx->create_pnext = &ass->amd_vk_mod_list_info;
+
+        vk_hwctx->tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+
+        ret = av_hwframe_ctx_init(ass->amd_vk_frames_ref);
+        if (ret < 0) {
+            av_log(avctx, AV_LOG_ERROR,
+                   "inlineass(amd-vk): Vulkan frames-ctx init failed: %s\n",
+                   av_err2str(ret));
+            return ret;
+        }
+    }
+
+    /* Output link: pass-through geometry. When the Vulkan intermediate pool's
+     * sw_format == input sw_format (SDR), reuse the input frames pool (zero
+     * new alloc, same encoder-friendly ctx — original v5 behavior). When HDR
+     * was tonemapped to SDR nv12 above, the input pool's sw_format
+     * (p010/p012/p016) no longer matches what vulkan_map_to_vaapi will
+     * export — allocate a fresh nv12 VAAPI pool on the same device
+     * (issue #123 v6). */
+    il = ff_filter_link(inlink);
+    ol = ff_filter_link(outlink);
+    outlink->w                   = inlink->w;
+    outlink->h                   = inlink->h;
+    outlink->format              = AV_PIX_FMT_VAAPI;
+    outlink->sample_aspect_ratio = inlink->sample_aspect_ratio;
+    outlink->time_base           = inlink->time_base;
+    ol->frame_rate               = il->frame_rate;
+    {
+        AVHWFramesContext *vkf = (AVHWFramesContext *)ass->amd_vk_frames_ref->data;
+        if (vkf->sw_format == in_frames->sw_format) {
+            ol->hw_frames_ctx = av_buffer_ref(il->hw_frames_ctx);
+            if (!ol->hw_frames_ctx)
+                return AVERROR(ENOMEM);
+        } else {
+            AVHWFramesContext *out_frames;
+            ol->hw_frames_ctx = av_hwframe_ctx_alloc(in_frames->device_ref);
+            if (!ol->hw_frames_ctx)
+                return AVERROR(ENOMEM);
+            out_frames                    = (AVHWFramesContext *)ol->hw_frames_ctx->data;
+            out_frames->format            = AV_PIX_FMT_VAAPI;
+            out_frames->sw_format         = vkf->sw_format;   /* nv12 */
+            out_frames->width             = inlink->w;
+            out_frames->height            = inlink->h;
+            out_frames->initial_pool_size = 4;
+            ret = av_hwframe_ctx_init(ol->hw_frames_ctx);
+            if (ret < 0) {
+                av_log(avctx, AV_LOG_ERROR,
+                       "inlineass(amd-vk): SDR VAAPI frames-ctx init failed: %s\n",
+                       av_err2str(ret));
+                return ret;
+            }
+            av_log(avctx, AV_LOG_VERBOSE,
+                   "inlineass(amd-vk): tonemap target pool: VAAPI nv12 %dx%d (input was %s)\n",
+                   inlink->w, inlink->h, av_get_pix_fmt_name(in_frames->sw_format));
+        }
+    }
+
+    /* Render-res cap mirrors the VAAPI/CUDA branches: rasterise libass at a
+     * capped height (ow x oh) and let pl_render_image upscale via the
+     * overlay's natural texture sampling. Folds in the SCALEPLEX_SUB_RENDER_HEIGHT
+     * knob via the existing render_height filter option. */
+    {
+        int in_w = inlink->w;
+        int in_h = inlink->h;
+        int rh   = ass->render_height;
+        int sw, sh;
+        compute_cap_dims(in_w, in_h, rh, &sw, &sh);
+        if (ass->animated_tier_down) {
+            int eff = (rh > 0 && rh < in_h) ? rh : in_h;
+            compute_cap_dims(in_w, in_h, tier_down(eff), &ass->anim_ow, &ass->anim_oh);
+        } else {
+            ass->anim_ow = sw;
+            ass->anim_oh = sh;
+        }
+        if (ass->animated && ass->animated_tier_down) {
+            ass->ow = ass->anim_ow;
+            ass->oh = ass->anim_oh;
+            ass->anim_active = 1;
+        } else {
+            ass->ow = sw;
+            ass->oh = sh;
+        }
+        av_log(avctx, AV_LOG_VERBOSE,
+               "inlineass(amd-vk): render %dx%d -> output %dx%d (render_height=%d, anim_tier=%dx%d%s)\n",
+               ass->ow, ass->oh, in_w, in_h, rh, ass->anim_ow, ass->anim_oh,
+               ass->anim_active ? " active" : "");
+    }
+
+    /* libass renderer geometry/fonts — identical to the VAAPI branch.
+     * cpu BGRA staging is shared with the VAAPI-VPP branch (render_ass_images
+     * writes premultiplied BGRA there); we upload it into pl_tex per cue
+     * change instead of av_hwframe_transfer_data on a VAAPI surface. */
+    pthread_mutex_lock(&inlineass_lock);
+    ass_set_frame_size(ass->renderer, ass->ow, ass->oh);
+    ass_set_pixel_aspect(ass->renderer, 1.0);
+    ass_set_font_scale(ass->renderer, ass->font_scale);
+    if (ass->storage_w > 0 && ass->storage_h > 0)
+        ass_set_storage_size(ass->renderer, ass->storage_w, ass->storage_h);
+    ass_set_fonts(ass->renderer, ass->font_path, "DejaVu Sans",
+                  ASS_FONTPROVIDER_AUTODETECT, ass->fc_file, 1);
+    pthread_mutex_unlock(&inlineass_lock);
+
+    /* Allocate the BGRA staging buffer (s->cpu) the libass text path writes
+     * into. We don't allocate a VAAPI overlay surface (the VAAPI-VPP branch
+     * does that); pl_tex_recreate manages the GPU texture lazily on first
+     * cue. */
+    ass->cpu = av_frame_alloc();
+    if (!ass->cpu)
+        return AVERROR(ENOMEM);
+    ass->cpu->format = AV_PIX_FMT_BGRA;
+    ass->cpu->width  = ass->ow;
+    ass->cpu->height = ass->oh;
+    ret = av_frame_get_buffer(ass->cpu, 0);
+    if (ret < 0)
+        return ret;
+    return 0;
+}
+
+/* Render the libass band into ass->cpu (premultiplied BGRA, shared with the
+ * VAAPI-VPP branch). Sets ass->have_overlay = 1 iff a visible cue exists.
+ * Reuses render_ass_images() + the inlineass_lock from patch 0115. */
+static int inlineass_amd_refresh_overlay(AVFilterContext *avctx, int64_t time_ms)
+{
+    AssContext *ass = avctx->priv;
+    int change = 0, clear = 0, do_render = 0;
+    ASS_Image *img;
+
+    pthread_mutex_lock(&inlineass_lock);
+    img = ass_render_frame(ass->renderer, ass->track, time_ms, &change);
+    if (change) {
+        if (!img) {
+            clear = 1;
+        } else {
+            memset(ass->cpu->data[0], 0,
+                   (size_t)ass->cpu->linesize[0] * ass->oh);
+            render_ass_images(ass->cpu->data[0], ass->cpu->linesize[0],
+                              ass->ow, ass->oh, img);
+            do_render = 1;
+        }
+    }
+    pthread_mutex_unlock(&inlineass_lock);
+
+    if (clear) {
+        ass->amd_have_overlay = 0;
+        return 0;
+    }
+    if (do_render) {
+        /* The actual pl_tex upload happens in filter_frame, where we hold the
+         * GPU context for the blend — keeps the lock scope minimal. The CPU
+         * data is staged here; mark it as "needs re-upload" by latching the
+         * have_overlay flag (we keep the BGRA buffer as the canonical copy). */
+        ass->amd_have_overlay = 1;
+        /* TODO(amd-vk-validate): we re-upload the whole band texture per cue
+         * change. mpv's update_overlays() uses an inflight queue so it can
+         * recycle the previous texture if the band size matches. For sub
+         * burn-in the cue change rate is ~1 Hz, so the simpler always-upload
+         * is fine; revisit if profiling shows GPU-upload churn. */
+    }
+    return 0;
+}
+
+/* Per-frame AMD-Vulkan composite: refresh the libass band → upload to the
+ * cached pl_tex (size-aware: recreate when band dims change) → map src/dst
+ * VAAPI AVFrames as pl_frame via pl_map_avframe_ex → attach the band as a
+ * pl_overlay on the source → pl_render_image() blends into the dst surface
+ * → forward dst. Mirrors mpv vo_gpu_next update_overlays() lifecycle. */
+static int filter_frame_amd_vk(AVFilterLink *inlink, AVFrame *in)
+{
+    AVFilterContext *avctx   = inlink->dst;
+    AVFilterLink    *outlink = avctx->outputs[0];
+    AssContext      *ass     = avctx->priv;
+    AVFrame         *out     = NULL;
+    AVFrame         *vk_tgt  = NULL;
+    pl_fmt           bgra_fmt;
+    struct pl_frame  pl_src = {0}, pl_tgt = {0};
+    struct pl_overlay_part part;
+    struct pl_overlay      ol_text, ol_bmp;
+    struct pl_overlay      overlays[2];
+    int                    num_overlays = 0;
+    int64_t                time_ms;
+    bool                   ok;
+    int                    ret, src_mapped = 0, tgt_mapped = 0;
+
+    time_ms = av_rescale_q(in->pts, inlink->time_base, ASS_TIME_BASE);
+
+    /* Refresh text + bitmap overlays. Text writes to ass->cpu (BGRA premult);
+     * bitmap presentation lives in bmp_pending_buf (same premult BGRA).
+     * Skipped when tonemap_only — the filter is then a pure HDR→SDR
+     * pl_render_image pass with no overlay (issue #123 v6). */
+    if (!ass->tonemap_only) {
+        ret = inlineass_amd_refresh_overlay(avctx, time_ms);
+        if (ret < 0)
+            goto fail;
+        ret = refresh_bitmap(avctx, time_ms);   /* shared with VAAPI branch */
+        if (ret < 0)
+            goto fail;
+    }
+
+    /* Allocate the RENDER TARGET from the intermediate Vulkan pool (NOT
+     * the VAAPI pool — see the inlineass_amd_vk_config comment block).
+     * The Vulkan frames-ctx was created with COLOR_ATTACHMENT_BIT, so the
+     * pl_tex libplacebo derives in pl_map_avframe_ex (via
+     * pl_map_avframe_vulkan, which passes vkfc->usage through to
+     * pl_vulkan_wrap) IS renderable — unlike the VAAPI→DRM→Vulkan import
+     * path which hard-codes sampleable only. After rendering we DMA-BUF
+     * map the Vulkan frame to a VAAPI AVFrame for the downstream
+     * encoder. */
+    vk_tgt = av_frame_alloc();
+    if (!vk_tgt) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    ret = av_hwframe_get_buffer(ass->amd_vk_frames_ref, vk_tgt, 0);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_ERROR,
+               "inlineass(amd-vk): av_hwframe_get_buffer(vulkan) failed: %s\n",
+               av_err2str(ret));
+        goto fail;
+    }
+    ret = av_frame_copy_props(vk_tgt, in);
+    if (ret < 0)
+        goto fail;
+    vk_tgt->width  = in->width;
+    vk_tgt->height = in->height;
+
+    /* Allocate the VAAPI AVFrame the downstream encoder will consume.
+     * Filled in below via av_hwframe_map; it carries the same DMA-BUF
+     * backing as vk_tgt — zero GPU-side copy. */
+    out = av_frame_alloc();
+    if (!out) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+
+    bgra_fmt = pl_find_named_fmt(ass->amd_pl_vk->gpu, "bgra8");
+    if (!bgra_fmt) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): no bgra8 format\n");
+        ret = AVERROR(EIO);
+        goto fail;
+    }
+
+    /* (Re)create + upload the TEXT band texture on visible cue. pl_tex_recreate
+     * is a no-op if params match; otherwise it destroys the old tex first. */
+    if (ass->amd_have_overlay && ass->cpu) {
+        if (!pl_tex_recreate(ass->amd_pl_vk->gpu, &ass->amd_overlay_tex,
+            pl_tex_params(
+                .format        = bgra_fmt,
+                .w             = ass->cpu->width,
+                .h             = ass->cpu->height,
+                .host_writable = true,
+                .sampleable    = true,
+            ))) {
+            av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): pl_tex_recreate(text) failed\n");
+            ret = AVERROR(EIO);
+            goto fail;
+        }
+        if (!pl_tex_upload(ass->amd_pl_vk->gpu, pl_tex_transfer_params(
+                .tex       = ass->amd_overlay_tex,
+                .row_pitch = ass->cpu->linesize[0],
+                .ptr       = ass->cpu->data[0],
+            ))) {
+            av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): pl_tex_upload(text) failed\n");
+            ret = AVERROR(EIO);
+            goto fail;
+        }
+        ass->amd_overlay_w = ass->cpu->width;
+        ass->amd_overlay_h = ass->cpu->height;
+    }
+
+    /* (Re)create + upload the BITMAP texture on active bmp cue (PGS/DVD/DVB).
+     * Source is bmp_pending_buf (premultiplied BGRA, decoder-thread staged).
+     * Lock scope mirrors refresh_bitmap: read under inlineass_lock, upload
+     * outside. */
+    if (ass->bmp_clock.active && ass->bmp_pending_buf) {
+        uint8_t *bmp_copy = NULL;
+        int bmp_w = 0, bmp_h = 0, bmp_stride = 0;
+        pthread_mutex_lock(&inlineass_lock);
+        bmp_w      = ass->bmp_cw;
+        bmp_h      = ass->bmp_ch;
+        bmp_stride = ass->bmp_pending_stride;
+        if (bmp_w > 0 && bmp_h > 0 && bmp_stride > 0) {
+            bmp_copy = av_malloc((size_t)bmp_stride * bmp_h);
+            if (bmp_copy)
+                memcpy(bmp_copy, ass->bmp_pending_buf, (size_t)bmp_stride * bmp_h);
+        }
+        pthread_mutex_unlock(&inlineass_lock);
+
+        if (bmp_copy) {
+            if (!pl_tex_recreate(ass->amd_pl_vk->gpu, &ass->amd_bmp_tex,
+                pl_tex_params(
+                    .format        = bgra_fmt,
+                    .w             = bmp_w,
+                    .h             = bmp_h,
+                    .host_writable = true,
+                    .sampleable    = true,
+                ))) {
+                av_free(bmp_copy);
+                av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): pl_tex_recreate(bmp) failed\n");
+                ret = AVERROR(EIO);
+                goto fail;
+            }
+            if (!pl_tex_upload(ass->amd_pl_vk->gpu, pl_tex_transfer_params(
+                    .tex       = ass->amd_bmp_tex,
+                    .row_pitch = bmp_stride,
+                    .ptr       = bmp_copy,
+                ))) {
+                av_free(bmp_copy);
+                av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): pl_tex_upload(bmp) failed\n");
+                ret = AVERROR(EIO);
+                goto fail;
+            }
+            av_free(bmp_copy);
+            ass->amd_bmp_tex_w = bmp_w;
+            ass->amd_bmp_tex_h = bmp_h;
+        }
+    }
+
+    /* Map VAAPI input + output as pl_frame. libplacebo handles the
+     * VAAPI→DMA-BUF→Vulkan import path transparently (mpv-proven on RADV).
+     *
+     * TODO(amd-vk-validate): if pl_map_avframe_ex fails on a VAAPI input on
+     * this radeonsi/libplacebo combo, fall back to a manual
+     * vaExportSurfaceHandle + pl_vulkan_wrap (replicating libplacebo's own
+     * internal path). mpv works on AMD, so the path exists; ffmpeg's
+     * wrapper layer may have a gap. */
+    if (!pl_map_avframe_ex(ass->amd_pl_vk->gpu, &pl_src,
+                           pl_avframe_params(.frame = in))) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): pl_map_avframe_ex(src) failed\n");
+        ret = AVERROR(EIO);
+        goto fail;
+    }
+    src_mapped = 1;
+    if (!pl_map_avframe_ex(ass->amd_pl_vk->gpu, &pl_tgt,
+                           pl_avframe_params(.frame = vk_tgt))) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): pl_map_avframe_ex(dst) failed\n");
+        ret = AVERROR(EIO);
+        goto fail;
+    }
+    tgt_mapped = 1;
+
+    /* scaleplex (patch 0127 v6, issue #123): absorb HDR→SDR tonemap into the
+     * same pl_render_image dispatch. pl_map_avframe_ex populates pl_src.color
+     * from the AVFrame's color_trc/color_primaries/colorspace via libplacebo's
+     * pl_map_avframe → pl_color_space_from_avframe path; if the source is HDR
+     * (PQ / HLG / any pl_color_transfer_is_hdr trc) we override the TARGET
+     * color space to bt709 SDR so libplacebo's draw_overlays() internal
+     * pipeline runs the HDR→SDR EOTF + tone-mapping along with the overlay
+     * blend — one GPU dispatch, zero extra filters.
+     *
+     * Subs-with-HDR sessions get this transparently (no rewriter change for
+     * the overlay path itself). Subs-less HDR sessions enter here via the
+     * tonemap_only=1 opt — they're a pure tonemap pass with zero overlays
+     * attached below. SDR sources fall through to pl_tgt.color = pl_src.color
+     * (libplacebo's pl_map_avframe default), so non-HDR + non-AMD-Vulkan
+     * paths are unaffected.
+     *
+     * TODO(amd-vk-v6:hdr-metadata): libplacebo honors HDR10 MaxCLL/MaxFALL
+     * from pl_src.color.hdr for better tone-curve tuning. pl_map_avframe
+     * fills hdr from AVMasteringDisplayMetadata side-data when present; if
+     * Plex strips that side-data the tonemap falls back to default params.
+     * Live-validation gate to confirm side-data survival end-to-end. */
+    /* scaleplex (patch 0127 v7, issue #137): gate the HDR→SDR target-color
+     * override on ass->hdr_to_sdr — the rewriter's explicit intent. Scaleplex
+     * policy "never inject tonemap; Plex's argv decides"
+     * (project_scaleplex_tonemap_policy): HDR-passthrough sessions (HDR client
+     * + HDR output) must NOT be SDR-mapped, and must NOT pay the libplacebo
+     * tonemap dispatch cost. The pl_color_transfer_is_hdr() check is kept as
+     * a safety: don't override an already-SDR source even if the rewriter
+     * mis-sets the flag, but the rewriter's intent is the trigger. */
+    if (ass->hdr_to_sdr && pl_color_transfer_is_hdr(pl_src.color.transfer)) {
+        pl_tgt.color = pl_color_space_bt709;
+        av_log(avctx, AV_LOG_VERBOSE,
+               "inlineass(amd-vk): HDR src (trc=%d) → SDR bt709 tgt (libplacebo tonemap)%s\n",
+               pl_src.color.transfer,
+               ass->tonemap_only ? " [tonemap_only]" : "");
+    }
+
+    /* Attach overlays. A stream is text XOR bitmap (PGS preferred when both
+     * active, mirroring the VAAPI/CUDA branches' precedence). Single full-tex
+     * src part stretched onto the full dst frame (DST_FRAME coords) — same
+     * geometry the VAAPI-VPP branch achieves via output_region. Attached to
+     * pl_tgt (mpv vo_gpu_next OSD pattern); pl_src-attach pushes the blend
+     * through the source plane-decomposition path which mishandles non-RGB
+     * source frames. .color = pl_src.color so libplacebo composites the
+     * libass-rendered BGRA in the source frame's color space (mpv's
+     * video-synced sub pattern, vo_gpu_next.c::update_overlays SUBBITMAP_BGRA
+     * branch). pl_color_space_unknown defaults to a dim sRGB→dst mapping
+     * that visibly attenuates the burn vs the Intel VAAPI-VPP reference. */
+    part = (struct pl_overlay_part) {
+        .src   = { 0, 0, 0, 0 },
+        .dst   = { 0, 0, 0, 0 },
+        .color = { 1.0f, 1.0f, 1.0f, 1.0f },
+    };
+
+    if (ass->bmp_clock.active && ass->amd_bmp_tex) {
+        part.src.x1 = ass->amd_bmp_tex_w;
+        part.src.y1 = ass->amd_bmp_tex_h;
+        part.dst.x1 = in->width;
+        part.dst.y1 = in->height;
+        ol_bmp = (struct pl_overlay) {
+            .tex       = ass->amd_bmp_tex,
+            .mode      = PL_OVERLAY_NORMAL,
+            .coords    = PL_OVERLAY_COORDS_DST_FRAME,
+            .repr      = { .alpha = PL_ALPHA_PREMULTIPLIED },
+            .color     = pl_src.color,
+            .parts     = &part,
+            .num_parts = 1,
+        };
+        overlays[num_overlays++] = ol_bmp;
+    } else if (ass->amd_have_overlay && ass->amd_overlay_tex) {
+        part.src.x1 = ass->amd_overlay_w;
+        part.src.y1 = ass->amd_overlay_h;
+        part.dst.x1 = in->width;
+        part.dst.y1 = in->height;
+        ol_text = (struct pl_overlay) {
+            .tex       = ass->amd_overlay_tex,
+            .mode      = PL_OVERLAY_NORMAL,
+            .coords    = PL_OVERLAY_COORDS_DST_FRAME,
+            .repr      = { .alpha = PL_ALPHA_PREMULTIPLIED },
+            .color     = pl_src.color,
+            .parts     = &part,
+            .num_parts = 1,
+        };
+        overlays[num_overlays++] = ol_text;
+    }
+    pl_tgt.overlays     = overlays;
+    pl_tgt.num_overlays = num_overlays;
+
+    /* The render call that dodges overlay_vulkan + libplacebo inputs=2
+     * (both broken on RADV). pl_render_image dispatches via libplacebo's
+     * own draw_overlays() — mpv's working path. */
+    ok = pl_render_image(ass->amd_pl_rr, &pl_src, &pl_tgt, &pl_render_default_params);
+    if (!ok) {
+        av_log(avctx, AV_LOG_ERROR, "inlineass(amd-vk): pl_render_image failed\n");
+        ret = AVERROR(EIO);
+        goto fail;
+    }
+
+    pl_unmap_avframe(ass->amd_pl_vk->gpu, &pl_src);
+    src_mapped = 0;
+    pl_unmap_avframe(ass->amd_pl_vk->gpu, &pl_tgt);
+    tgt_mapped = 0;
+
+    /* Vulkan → VAAPI map: produces a VAAPI AVFrame whose VASurface is a
+     * dma-buf import of the Vulkan VkImage memory we just rendered into.
+     * av_hwframe_map sets out->format = AV_PIX_FMT_VAAPI + width/height
+     * + hw_frames_ctx, and attaches an internal HWMapDescriptor that
+     * keeps vk_tgt alive for the lifetime of the mapped frame. The
+     * downstream encoder sees a normal VAAPI frame. */
+    /* av_hwframe_map() dispatch (hwcontext.c:807) needs an hwfc on dst to
+     * find the VAAPI map_to hook; without it the call falls through to
+     * the unconditional ENOSYS at hwcontext.c:866 even though
+     * vulkan_map_to_drm succeeds. Reuse the outlink's VAAPI pool ref
+     * (same device the input pool came from); vaapi_map_from_drm
+     * vaCreateSurfaces a fresh surface for data[3] and ignores the pool
+     * itself. MAP_DIRECT is dropped — only consulted by vaapi_map_frame
+     * (download), not the DRM-prime import. */
+    out->format        = AV_PIX_FMT_VAAPI;
+    out->hw_frames_ctx = av_buffer_ref(ff_filter_link(outlink)->hw_frames_ctx);
+    if (!out->hw_frames_ctx) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    ret = av_hwframe_map(out, vk_tgt, AV_HWFRAME_MAP_READ);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_ERROR,
