+    }
 
 #if CONFIG_OVERLAY_CUDA_FILTER
     if (link->format == AV_PIX_FMT_CUDA)
@@ -1802,6 +2411,12 @@ static int config_output(AVFilterLink *outlink)
     }
 #endif /* CONFIG_OVERLAY_CUDA_FILTER */
 
+#if CONFIG_LIBPLACEBO_FILTER
