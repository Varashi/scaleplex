+// scaleplex: map a libx264-style preset name onto the iHD VAAPI
+// TargetUsage scale (1 = quality .. 7 = fastest). Mirrors the values the
+// scaleplex Go rewriter used before this moved into the encoder
+// (on-cluster Arc A310 bench 2026-05-05). Unknown -> fastest, since the
+// worker only runs under the orchestrator and playback latency wins.
+static int vaapi_encode_preset_to_quality(const char *preset)
+{
+    static const struct { const char *name; int q; } presets[] = {
+        { "ultrafast", 7 }, { "superfast", 7 }, { "veryfast", 6 },
+        { "faster",    5 }, { "fast",      4 }, { "medium",   4 },
+        { "slow",      3 }, { "slower",    2 }, { "veryslow", 1 },
+        { "placebo",   1 },
+    };
+    int i;
+    for (i = 0; i < (int)FF_ARRAY_ELEMS(presets); i++)
+        if (!av_strcasecmp(preset, presets[i].name))
+            return presets[i].q;
+    return 7;
+}
+
