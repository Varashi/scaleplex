+    if (!o->nb_dst) {
+        av_frame_unref(frame);
+        return 0;
+    }
+
     for (unsigned i = 0; i < o->nb_dst; i++) {
         uint8_t *finished = &o->dst_finished[i];
         AVFrame *to_send  = frame;
diff --git a/fftools/ffmpeg_sched.h b/fftools/ffmpeg_sched.h
index c0c2892..edde3e2 100644
--- a/fftools/ffmpeg_sched.h
+++ b/fftools/ffmpeg_sched.h
@@ -191,6 +191,17 @@ int sch_add_dec(Scheduler *sch, SchThreadFunc func, void *ctx, int send_end_ts);
  */
 int sch_add_dec_output(Scheduler *sch, unsigned dec_idx);
 
+/**
+ * scaleplex: mark a decoder as sink-less.
+ *
+ * Its decoded frames are consumed via a side-channel (the vf_inlineass
+ * feed in transcode_subtitles), not through a scheduler output. The
+ * auto-created output 0 is left unconnected: start_prepare() tolerates it
+ * and sch_dec_send() discards frames sent to an output with no sink. The
+ * decoder must still be connected to a source (the demuxer stream).
+ */
+void sch_dec_set_sinkless(Scheduler *sch, unsigned dec_idx);
