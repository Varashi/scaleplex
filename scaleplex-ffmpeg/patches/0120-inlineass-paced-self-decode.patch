diff --git a/fftools/scaleplex_inlineass.c b/fftools/scaleplex_inlineass.c
index 52b98fc..594b3ed 100644
--- a/fftools/scaleplex_inlineass.c
+++ b/fftools/scaleplex_inlineass.c
@@ -441,6 +441,36 @@ void scaleplex_inlineass_handle_subtitle(AVCodecContext *dec_ctx, AVSubtitle *su
     pthread_mutex_unlock(&bindings_lock);
 }
 
+int scaleplex_inlineass_setup_decoders(void)
+{
+    int ret = 0;
+
+    pthread_mutex_lock(&bindings_lock);
+    for (int i = 0; i < nb_bindings; i++) {
+        InlineAssBinding *b = &bindings[i];
+
+        if (!b->ist)
+            continue;
+
+        ret = ist_inlineass_add(b->ist);
+        if (ret < 0) {
+            av_log(NULL, AV_LOG_FATAL,
+                   "scaleplex_inlineass: failed to create side-channel "
+                   "decoder for bind#%d (input #%d:%s): %s\n",
+                   i, b->file_idx, b->stream_spec, av_err2str(ret));
+            break;
+        }
+        av_log(NULL, AV_LOG_VERBOSE,
+               "scaleplex_inlineass: side-channel decoder ready for bind#%d "
+               "(input #%d:%s, sch_dec=%d)\n",
+               i, b->file_idx, b->stream_spec, ret);
+        ret = 0;
+    }
+    pthread_mutex_unlock(&bindings_lock);
+
+    return ret;
+}
+
 void scaleplex_inlineass_uninit(void)
 {
     pthread_mutex_lock(&bindings_lock);
diff --git a/fftools/scaleplex_inlineass.h b/fftools/scaleplex_inlineass.h
