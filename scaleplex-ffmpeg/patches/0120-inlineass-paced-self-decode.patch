--- a/fftools/scaleplex_inlineass.h
+++ b/fftools/scaleplex_inlineass.h
@@ -45,6 +45,14 @@ void scaleplex_inlineass_link_graph(struct AVFilterGraph *graph);
 void scaleplex_inlineass_handle_subtitle(AVCodecContext *dec_ctx,
                                          AVSubtitle *sub);
 
+/* Called from transcode() in ffmpeg.c just before sch_start(). For every
+ * queued -map_inlineass binding, creates a sink-less decoder on the
+ * referenced input stream (via ist_inlineass_add) so the stream decodes
+ * and feeds vf_inlineass through the side-channel — replacing the old
+ * `-map <spec> -f null -codec ass` decode-sink. Returns 0 on success (or
+ * when there are no bindings), AVERROR on failure. */
+int scaleplex_inlineass_setup_decoders(void);
+
 /* Frees the binding registry. Currently unused (the registry lives
  * for the lifetime of ffmpeg) but useful in case ffmpeg.c gains an
  * explicit shutdown path that wants to assert no leaks. */
