@@ -739,6 +743,14 @@ int sch_add_dec_output(Scheduler *sch, unsigned dec_idx)
     return dec->nb_outputs - 1;
 }
 
+void sch_dec_set_sinkless(Scheduler *sch, unsigned dec_idx)
+{
+    SchDec *dec;
+    av_assert0(dec_idx < sch->nb_dec);
+    dec = &sch->dec[dec_idx];
+    dec->sink_less = 1;
+}
