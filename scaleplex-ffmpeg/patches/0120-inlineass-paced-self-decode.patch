-            unchoke_downstream(sch, dec->outputs[i].dst);
+            /* scaleplex: a sink-less decoder output (the vf_inlineass
+             * side-channel) has nb_dst==0 and a NULL dst array — skip it,
+             * otherwise unchoke_downstream() dereferences NULL->type. */
+            if (dec->outputs[i].nb_dst)
+                unchoke_downstream(sch, dec->outputs[i].dst);
         break;
     case SCH_NODE_TYPE_ENC:
         enc = &sch->enc[dst->idx];
@@ -1496,6 +1512,11 @@ static int start_prepare(Scheduler *sch)
             return AVERROR(EINVAL);
         }
 
+        /* scaleplex: a sink-less decoder feeds a side-channel, not a
+         * scheduler output; its auto-created output 0 stays unconnected. */
+        if (dec->sink_less)
+            continue;
+
         for (unsigned j = 0; j < dec->nb_outputs; j++) {
             SchDecOutput *o = &dec->outputs[j];
 
@@ -2268,6 +2289,16 @@ int sch_dec_send(Scheduler *sch, unsigned dec_idx,
     av_assert0(out_idx < dec->nb_outputs);
     o = &dec->outputs[out_idx];
 
+    /* scaleplex: sink-less output (e.g. the vf_inlineass side-channel
+     * decoder). Discard the frame and report success — falling through
