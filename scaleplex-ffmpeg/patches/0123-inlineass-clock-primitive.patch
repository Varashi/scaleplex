--- ffmpeg.orig/libavfilter/vf_inlineass.c
+++ ffmpeg/libavfilter/vf_inlineass.c
@@ -62,6 +62,38 @@
 #include "video.h"
 #include "libavutil/frame.h"
 
+/* Display-window lifecycle for a single subtitle cue. Decoupled from
+ * libass so the bitmap path (PGS/DVD/DVB), which has no libass clock,
+ * can share a small, testable primitive with the text path. INT64_MIN
+ * is the open-ended sentinel: PGS PCS sets end_display_time=0, so the
+ * cue's true end is only known when an empty presentation arrives. */
+typedef struct SubCueClock {
+    int64_t start_ms;
+    int64_t end_ms;     /* INT64_MIN == open-ended (close-via-clear pending) */
+    int     active;     /* cached: result of last sub_cue_active_at() */
+} SubCueClock;
+
+static inline void sub_cue_set(SubCueClock *c,
+                               int64_t start_ms, int64_t end_ms_or_open)
+{
+    c->start_ms = start_ms;
+    c->end_ms   = (end_ms_or_open > start_ms) ? end_ms_or_open : INT64_MIN;
+    c->active   = 0;
+}
+
+static inline void sub_cue_close(SubCueClock *c, int64_t time_ms)
+{
+    c->end_ms = time_ms;   /* bound the window so active_at() cannot resurrect */
+    c->active = 0;
+}
+
+static inline int sub_cue_active_at(SubCueClock *c, int64_t time_ms)
+{
+    c->active = (time_ms >= c->start_ms) &&
+                (c->end_ms == INT64_MIN || time_ms < c->end_ms);
+    return c->active;
+}
