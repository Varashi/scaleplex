+        AVFrame *ov = ass->have_bmp     ? ass->bmp_overlay
+                    : ass->have_overlay ? ass->overlay
+                    : NULL;
+        if (ov) {
+            memcpy(&params[1], &params[0], sizeof(params[0]));
+            blend.flags = VA_BLEND_PREMULTIPLIED_ALPHA;   /* both buffers are premultiplied */
+            params[1].blend_state    = &blend;
+            params[1].surface        = ff_vaapi_vpp_get_surface_id(ov);
+            params[1].surface_region = NULL;   /* whole overlay (its native render/canvas size) */
+            overlay_region = (VARectangle) {
+                .x = 0, .y = 0, .width = output->width, .height = output->height,
+            };
+            params[1].output_region = &overlay_region;
+            nb_params = 2;
+        }
+    }
+
+    err = ff_vaapi_vpp_render_pictures(avctx, params, nb_params, output);
+    if (err < 0)
+        goto fail;
+
+    av_frame_free(&input);
+    return ff_filter_frame(outlink, output);
+
+fail:
+    av_frame_free(&input);
+    av_frame_free(&output);
+    return err;
+}
