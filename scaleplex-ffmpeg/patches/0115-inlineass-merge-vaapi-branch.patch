+        err = AVERROR(EINVAL);
+        goto fail;
+    }
+
+    time_ms = av_rescale_q(input->pts, inlink->time_base, ASS_TIME_BASE);
+    err = refresh_overlay(avctx, time_ms);   /* libass text path */
+    if (err < 0)
+        goto fail;
+    err = refresh_bitmap(avctx, time_ms);    /* PGS/bitmap path (dormant for text) */
+    if (err < 0)
+        goto fail;
+
+    output = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+    if (!output) {
+        err = AVERROR(ENOMEM);
+        goto fail;
+    }
+    err = av_frame_copy_props(output, input);
+    if (err < 0)
+        goto fail;
+
+    err = ff_vaapi_vpp_init_params(avctx, &params[0], input, output);
+    if (err < 0)
+        goto fail;
+    output_region = (VARectangle) {
+        .x = 0, .y = 0, .width = output->width, .height = output->height,
+    };
+    params[0].output_region           = &output_region;
+    params[0].output_background_color = VAAPI_VPP_BACKGROUND_BLACK;
+
+    /* Always VPP-render to an output-pool frame. When a cue is visible, add
+     * the overlay surface as a premultiplied-alpha blended second layer;
+     * otherwise render the main only (count = 1). A stream is text XOR bitmap
+     * — prefer the bitmap overlay (PGS) if present, else the libass text
+     * overlay. Never pass the input frame straight through — its
+     * hw_frames_ctx differs from the output link's pool, which crashes the
+     * downstream HW encoder. */
+    nb_params = 1;
