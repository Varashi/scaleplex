+/* ======================================================================== *
+ *  HW (VAAPI) branch — merged from the former vf_overlay_sub_vaapi (0112).  *
+ *  All libass call sites run under inlineass_lock (shared with the SW       *
+ *  branch + the fftools feed). Field names match AssContext.                *
+ * ======================================================================== */
+
+static int inlineass_create_overlay(AVFilterContext *avctx);   /* fwd */
+
+static int inlineass_build_filter_params(AVFilterContext *avctx)
+{
+    VAAPIVPPContext *vpp_ctx = avctx->priv;
+    VAStatus vas;
+    VAProcPipelineCaps caps;
+
+    memset(&caps, 0, sizeof(caps));
+    vas = vaQueryVideoProcPipelineCaps(vpp_ctx->hwctx->display,
+                                       vpp_ctx->va_context, NULL, 0, &caps);
+    if (vas != VA_STATUS_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to query pipeline caps: %d (%s).\n",
+               vas, vaErrorStr(vas));
+        return AVERROR(EIO);
+    }
+    if (!caps.blend_flags) {
+        av_log(avctx, AV_LOG_ERROR, "VAAPI driver doesn't support overlay blend.\n");
+        return AVERROR(EINVAL);
+    }
+    return 0;
+}
+
+/* Composite the libass image list into the (cleared) premultiplied BGRA
+ * staging buffer. Plain source-over with per-pixel alpha — no colour
+ * mangle. libass color is RRGGBBTT (TT = transparency, opacity = 255-TT). */
+static void render_ass_images(uint8_t *buf, int stride, int w, int h,
+                              const ASS_Image *img)
+{
+    for (; img; img = img->next) {
+        int rr = (img->color >> 24) & 0xFF;
+        int gg = (img->color >> 16) & 0xFF;
+        int bb = (img->color >>  8) & 0xFF;
+        int op = 255 - (img->color & 0xFF);   /* cue opacity */
+        int y, x;
+        if (op == 0)
+            continue;
+        for (y = 0; y < img->h; y++) {
+            int dy = img->dst_y + y;
+            const uint8_t *src;
+            uint8_t *dst;
+            if (dy < 0 || dy >= h)
+                continue;
+            src = img->bitmap + (ptrdiff_t)y * img->stride;
+            dst = buf + (ptrdiff_t)dy * stride;
+            for (x = 0; x < img->w; x++) {
+                int dx = img->dst_x + x;
+                int a, ia;
+                uint8_t *p;
+                if (dx < 0 || dx >= w)
+                    continue;
+                a = op * src[x] / 255;          /* src alpha 0..255 */
+                if (a == 0)
+                    continue;
+                ia = 255 - a;
+                p = dst + (ptrdiff_t)dx * 4;     /* BGRA, premultiplied */
+                p[0] = (bb * a + p[0] * ia) / 255;
+                p[1] = (gg * a + p[1] * ia) / 255;
+                p[2] = (rr * a + p[2] * ia) / 255;
+                p[3] = (a * 255 + p[3] * ia) / 255;
+            }
+        }
+    }
+}
+
+/* Aspect-preserving even dims for a target raster height (target_h<=0 or
+ * >= in_h = no cap → full res). Shared by the static + animated tiers. */
+static void compute_cap_dims(int in_w, int in_h, int target_h, int *ow, int *oh)
+{
+    if (target_h <= 0 || target_h >= in_h) {
+        *oh = in_h;
+        *ow = in_w;
+    } else {
+        *oh = target_h & ~1;
+        *ow = ((int)((int64_t)in_w * (*oh) / in_h) + 1) & ~1;
+    }
+}
+
+/* One standard resolution tier below h (1080->720, 720->540, ...). */
+static int tier_down(int h)
+{
+    static const int tiers[] = { 2160, 1440, 1080, 720, 540, 480, 360 };
+    int n = (int)(sizeof(tiers) / sizeof(tiers[0])), i;
+    for (i = 0; i < n; i++)
+        if (h >= tiers[i])
+            return (i + 1 < n) ? tiers[i + 1] : tiers[i];
+    return h;
+}
+
+/* True when an ASS event line carries a per-frame animation override
+ * (\move, \t(...), karaoke \k*, \fad). Such cues defeat render-once-per-cue
+ * (libass reports change every frame), so they get the lower animated tier. */
+static int ass_line_is_animated(const char *s)
+{
+    return s && (strstr(s, "\\move") || strstr(s, "\\t(") ||
+                 strstr(s, "\\k")    || strstr(s, "\\fad"));
+}
+
+/* Switch the text overlay to the lower animated tier (one-shot, filter
+ * thread, caller holds inlineass_lock). Re-inits libass frame size + reallocs
+ * the cached overlay surface; the next render repopulates it. */
+static int switch_to_animated_tier(AVFilterContext *avctx)
+{
+    AssContext *ass = avctx->priv;
+    ass_set_frame_size(ass->renderer, ass->anim_ow, ass->anim_oh);
+    av_frame_free(&ass->overlay);
+    av_frame_free(&ass->cpu);
+    av_buffer_unref(&ass->overlay_frames_ref);
+    ass->ow = ass->anim_ow;
+    ass->oh = ass->anim_oh;
+    ass->have_overlay = 0;
+    ass->anim_active  = 1;
+    av_log(avctx, AV_LOG_VERBOSE,
+           "inlineass(hw): animation detected -> render %dx%d (tier down)\n",
+           ass->ow, ass->oh);
+    return inlineass_create_overlay(avctx);
+}
+
+/* Render the cue active at time_ms; on change, re-rasterise + re-upload the
+ * cached overlay surface. Sets have_overlay = whether a cue is visible.
+ * libass calls + the image-list read run under inlineass_lock (the decoder
+ * thread may be feeding chunks concurrently). */
+static int refresh_overlay(AVFilterContext *avctx, int64_t time_ms)
+{
+    AssContext *ass = avctx->priv;
+    int change = 0, err = 0, do_upload = 0, clear = 0;
+    ASS_Image *img;
+
+    pthread_mutex_lock(&inlineass_lock);
+    /* One-shot drop to the animated tier once an animated cue is seen. */
+    if (ass->animated && ass->animated_tier_down && !ass->anim_active &&
+        (ass->anim_ow != ass->ow || ass->anim_oh != ass->oh)) {
+        err = switch_to_animated_tier(avctx);
+        if (err < 0) {
+            pthread_mutex_unlock(&inlineass_lock);
+            return err;
+        }
+    }
+    img = ass_render_frame(ass->renderer, ass->track, time_ms, &change);
+    if (change) {
+        if (!img) {
+            clear = 1;
+        } else {
+            memset(ass->cpu->data[0], 0, (size_t)ass->cpu->linesize[0] * ass->oh);
+            render_ass_images(ass->cpu->data[0], ass->cpu->linesize[0],
+                              ass->ow, ass->oh, img);
+            do_upload = 1;
+        }
+    }
+    pthread_mutex_unlock(&inlineass_lock);
+
+    if (clear) {
+        ass->have_overlay = 0;
+        return 0;
+    }
+    if (do_upload) {
+        err = av_hwframe_transfer_data(ass->overlay, ass->cpu, 0);
+        if (err < 0) {
+            av_log(avctx, AV_LOG_ERROR, "Failed to upload overlay surface: %d.\n", err);
+            return err;
+        }
+        ass->have_overlay = 1;
+    }
+    return 0;
+}
+
+static int inlineass_create_overlay(AVFilterContext *avctx)
+{
+    AssContext        *ass     = avctx->priv;
+    VAAPIVPPContext   *vpp_ctx = avctx->priv;
+    AVHWFramesContext *frames;
+    int err;
+
+    ass->overlay_frames_ref = av_hwframe_ctx_alloc(vpp_ctx->device_ref);
+    if (!ass->overlay_frames_ref)
+        return AVERROR(ENOMEM);
+    frames = (AVHWFramesContext *)ass->overlay_frames_ref->data;
+    frames->format            = AV_PIX_FMT_VAAPI;
+    frames->sw_format         = AV_PIX_FMT_BGRA;
+    frames->width             = ass->ow;
+    frames->height            = ass->oh;
+    frames->initial_pool_size = 1;
+    err = av_hwframe_ctx_init(ass->overlay_frames_ref);
+    if (err < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to init overlay frames ctx: %d.\n", err);
+        return err;
+    }
+
+    ass->overlay = av_frame_alloc();
+    if (!ass->overlay)
+        return AVERROR(ENOMEM);
+    err = av_hwframe_get_buffer(ass->overlay_frames_ref, ass->overlay, 0);
+    if (err < 0)
+        return err;
+
+    ass->cpu = av_frame_alloc();
+    if (!ass->cpu)
+        return AVERROR(ENOMEM);
+    ass->cpu->format = AV_PIX_FMT_BGRA;
+    ass->cpu->width  = ass->ow;
+    ass->cpu->height = ass->oh;
+    return av_frame_get_buffer(ass->cpu, 0);
+}
+
+/* ---- bitmap (PGS/DVD/DVB) path ----------------------------------------- */
+
+/* Blit one decoded bitmap rect (palettised) into the canvas BGRA buffer as
+ * PREMULTIPLIED BGRA (the composite uses VA_BLEND_PREMULTIPLIED_ALPHA). The
+ * AVSubtitle palette (rect->data[1]) is 256 native-endian 0xAARRGGBB. */
+static void blit_pgs_rect(uint8_t *buf, int stride, int cw, int ch,
+                          const AVSubtitleRect *r)
+{
+    const uint32_t *pal = (const uint32_t *)r->data[1];
+    const uint8_t  *src = r->data[0];
+    int x, y;
+
+    for (y = 0; y < r->h; y++) {
+        int dy = r->y + y;
+        if (dy < 0 || dy >= ch)
+            continue;
+        for (x = 0; x < r->w; x++) {
+            int dx = r->x + x;
+            uint32_t v;
+            int a;
+            uint8_t *p;
+            if (dx < 0 || dx >= cw)
+                continue;
+            v = pal[src[(ptrdiff_t)y * r->linesize[0] + x]];
+            a = (v >> 24) & 0xFF;
+            if (a == 0)
+                continue;
+            p = buf + (ptrdiff_t)dy * stride + (ptrdiff_t)dx * 4;
+            p[0] = ( v        & 0xFF) * a / 255;   /* B premult */
+            p[1] = ((v >>  8) & 0xFF) * a / 255;   /* G */
+            p[2] = ((v >> 16) & 0xFF) * a / 255;   /* R */
+            p[3] = a;
+        }
+    }
+}
+
+/* (Re)allocate the bitmap overlay surface + staging at canvas size w x h.
+ * Filter thread only. No-op when already that size. */
+static int ensure_bmp_overlay(AVFilterContext *avctx, int w, int h)
+{
+    AssContext        *ass     = avctx->priv;
+    VAAPIVPPContext   *vpp_ctx = avctx->priv;
+    AVHWFramesContext *frames;
+    int err;
+
+    if (ass->bmp_overlay && ass->bmp_surf_w == w && ass->bmp_surf_h == h)
+        return 0;
+
+    av_frame_free(&ass->bmp_overlay);
+    av_frame_free(&ass->bmp_cpu);
+    av_buffer_unref(&ass->bmp_frames_ref);
+    ass->bmp_surf_w = ass->bmp_surf_h = 0;
+
+    ass->bmp_frames_ref = av_hwframe_ctx_alloc(vpp_ctx->device_ref);
+    if (!ass->bmp_frames_ref)
+        return AVERROR(ENOMEM);
+    frames = (AVHWFramesContext *)ass->bmp_frames_ref->data;
+    frames->format            = AV_PIX_FMT_VAAPI;
+    frames->sw_format         = AV_PIX_FMT_BGRA;
+    frames->width             = w;
+    frames->height            = h;
+    frames->initial_pool_size = 1;
+    err = av_hwframe_ctx_init(ass->bmp_frames_ref);
+    if (err < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to init bitmap frames ctx: %d.\n", err);
+        return err;
+    }
+
+    ass->bmp_overlay = av_frame_alloc();
+    if (!ass->bmp_overlay)
+        return AVERROR(ENOMEM);
+    err = av_hwframe_get_buffer(ass->bmp_frames_ref, ass->bmp_overlay, 0);
+    if (err < 0)
+        return err;
+
+    ass->bmp_cpu = av_frame_alloc();
+    if (!ass->bmp_cpu)
+        return AVERROR(ENOMEM);
+    ass->bmp_cpu->format = AV_PIX_FMT_BGRA;
+    ass->bmp_cpu->width  = w;
+    ass->bmp_cpu->height = h;
+    err = av_frame_get_buffer(ass->bmp_cpu, 0);
+    if (err < 0)
+        return err;
+
+    ass->bmp_surf_w = w;
+    ass->bmp_surf_h = h;
+    return 0;
+}
+
+/* Convert one decoded bitmap presentation to premultiplied BGRA at the sub
+ * canvas size; staged into bmp_pending_buf for the filter thread to upload.
+ * Decoder thread; mirrors replay_chunk's role for the text path. */
+void avfilter_inlineass_replay_bitmap(AVFilterContext *avctx,
+                                      AVCodecContext *dec_ctx,
+                                      AVSubtitle *sub)
+{
+    AssContext *ass;
+    int cw, ch, i;
+    int64_t base_ms;
+
+    if (!avctx || !avctx->priv || !sub)
+        return;
+    ass = avctx->priv;
+
+    /* canvas = decoder presentation size (pgssubdec sets it after the PCS);
+     * fall back to 1920x1080 (Blu-ray PGS standard) when unknown. */
+    cw = (dec_ctx && dec_ctx->width  > 0) ? dec_ctx->width  : 1920;
+    ch = (dec_ctx && dec_ctx->height > 0) ? dec_ctx->height : 1080;
+    base_ms = av_rescale_q(sub->pts, AV_TIME_BASE_Q, ASS_TIME_BASE);
+
+    pthread_mutex_lock(&inlineass_lock);
+
+    if (cw != ass->bmp_cw || ch != ass->bmp_ch || !ass->bmp_pending_buf) {
+        av_freep(&ass->bmp_pending_buf);
+        ass->bmp_pending_stride = cw * 4;
+        ass->bmp_pending_buf = av_mallocz((size_t)ass->bmp_pending_stride * ch);
+        ass->bmp_cw = cw;
+        ass->bmp_ch = ch;
+    }
+    if (!ass->bmp_pending_buf) {
+        pthread_mutex_unlock(&inlineass_lock);
+        return;
+    }
+
+    if (sub->num_rects == 0) {
+        ass->bmp_pending       = 1;
+        ass->bmp_pending_clear = 1;
+    } else {
+        memset(ass->bmp_pending_buf, 0,
+               (size_t)ass->bmp_pending_stride * ch);
+        for (i = 0; i < sub->num_rects; i++) {
+            AVSubtitleRect *r = sub->rects[i];
+            if (!r || r->type != SUBTITLE_BITMAP || !r->data[0] || !r->data[1])
+                continue;
+            blit_pgs_rect(ass->bmp_pending_buf, ass->bmp_pending_stride, cw, ch, r);
+        }
+        ass->bmp_pending       = 1;
+        ass->bmp_pending_clear = 0;
+    }
+    ass->bmp_pend_start_ms = base_ms + sub->start_display_time;
+    ass->bmp_pend_end_ms   = (sub->end_display_time > sub->start_display_time)
+                           ? base_ms + sub->end_display_time : -1;
+    pthread_mutex_unlock(&inlineass_lock);
+}
+
+/* Upload a newly-staged bitmap presentation (filter thread) and gate
+ * have_bmp by the current display window. */
+static int refresh_bitmap(AVFilterContext *avctx, int64_t time_ms)
+{
+    AssContext *ass = avctx->priv;
+    int err = 0, do_upload = 0, clear = 0, cw = 0, ch = 0, stride = 0, y;
+    int64_t start_ms = 0, end_ms = -1;
+
+    pthread_mutex_lock(&inlineass_lock);
+    if (ass->bmp_pending) {
+        ass->bmp_pending = 0;
+        if (ass->bmp_pending_clear) {
+            clear = 1;
+        } else {
+            cw = ass->bmp_cw;
+            ch = ass->bmp_ch;
+            stride = ass->bmp_pending_stride;
+            if (ensure_bmp_overlay(avctx, cw, ch) >= 0 && ass->bmp_cpu) {
+                for (y = 0; y < ch; y++)
+                    memcpy(ass->bmp_cpu->data[0] + (ptrdiff_t)y * ass->bmp_cpu->linesize[0],
+                           ass->bmp_pending_buf + (ptrdiff_t)y * stride,
+                           (size_t)cw * 4);
+                do_upload = 1;
+                start_ms = ass->bmp_pend_start_ms;
+                end_ms   = ass->bmp_pend_end_ms;
+            }
+        }
+    }
+    pthread_mutex_unlock(&inlineass_lock);
+
+    if (clear) {
+        ass->have_bmp = 0;
+        return 0;
+    }
+    if (do_upload) {
+        err = av_hwframe_transfer_data(ass->bmp_overlay, ass->bmp_cpu, 0);
+        if (err < 0) {
+            av_log(avctx, AV_LOG_ERROR, "Failed to upload bitmap overlay: %d.\n", err);
+            return err;
+        }
+        ass->bmp_start_ms = start_ms;
