+/* HW (VAAPI) per-frame composite: refresh the cached overlay (text/bitmap)
+ * then VPP-blend it onto the video surface. Single input → no framesync. */
+static int filter_frame_hw(AVFilterLink *inlink, AVFrame *input)
+{
+    AVFilterContext *avctx   = inlink->dst;
+    AVFilterLink    *outlink = avctx->outputs[0];
