--- a/fftools/ffmpeg.h	2026-05-11 13:58:17.160978398 +0200
+++ b/fftools/ffmpeg.h	2026-05-11 23:53:40.688099665 +0200
@@ -727,6 +727,9 @@
 extern int64_t stats_period;
 extern int stdin_interaction;
 extern AVIOContext *progress_avio;
+// scaleplex/PLEX: canThrottle feedback loop.
+extern char *canthrottle_url;
+extern _Atomic int scaleplex_throttle_delay_us;
 extern float max_error_rate;
 
 extern char *filter_nbthreads;
--- a/fftools/ffmpeg.c	2026-05-11 13:58:17.160978398 +0200
+++ b/fftools/ffmpeg.c	2026-05-11 23:54:00.400078684 +0200
@@ -100,6 +100,9 @@
 
 static BenchmarkTimeStamps current_time;
 AVIOContext *progress_avio = NULL;
+// scaleplex/PLEX: canThrottle feedback (see ffmpeg.h)
+char *canthrottle_url = NULL;
+_Atomic int scaleplex_throttle_delay_us = 0;
 
 InputFile   **input_files   = NULL;
 int        nb_input_files   = 0;
@@ -694,6 +697,41 @@
         }
     }
 
+    // scaleplex/PLEX: canThrottle feedback. Open a one-shot PUT to
+    // canthrottle_url, read the response body, parse for the literal
+    // `canThrottle` substring. Set the atomic per-packet sleep
+    // accordingly. ~28% throughput in equilibrium when throttled.
+    // Errors fail-open (treat as not-throttled) so a flapping PMS
+    // doesn't strand the session paused.
+    if (canthrottle_url && !is_last_report) {
+        AVIOContext *ct_avio = NULL;
+        AVDictionary *opts = NULL;
+        av_dict_set(&opts, "method", "PUT", 0);
+        av_dict_set(&opts, "post_data", "", 0);
+        int ct_ret = avio_open2(&ct_avio, canthrottle_url,
+                                AVIO_FLAG_READ_WRITE, &int_cb, &opts);
+        av_dict_free(&opts);
+        if (ct_ret >= 0) {
+            char resp[256];
+            int n = avio_read(ct_avio, (unsigned char *)resp, sizeof(resp) - 1);
+            if (n > 0) {
+                resp[n] = 0;
+                if (strstr(resp, "canThrottle")) {
+                    if (scaleplex_throttle_delay_us == 0)
+                        av_log(NULL, AV_LOG_DEBUG,
+                               "scaleplex: throttle ON (canThrottle)\n");
+                    scaleplex_throttle_delay_us = 100 * 1000;
+                } else {
+                    if (scaleplex_throttle_delay_us != 0)
+                        av_log(NULL, AV_LOG_DEBUG,
+                               "scaleplex: throttle OFF\n");
+                    scaleplex_throttle_delay_us = 0;
+                }
+            }
+            avio_closep(&ct_avio);
+        }
+    }
+
     first_report = 0;
 }
 
