--- a/fftools/ffmpeg.c	2026-05-11 13:58:17.000000000 +0200
+++ b/fftools/ffmpeg.c	2026-05-12 10:40:05.000000000 +0200
@@ -100,6 +100,9 @@
 
 static BenchmarkTimeStamps current_time;
 AVIOContext *progress_avio = NULL;
+// scaleplex/PLEX: canThrottle feedback (see ffmpeg.h)
+char *canthrottle_url = NULL;
+_Atomic int scaleplex_throttle_delay_us = 0;
 
 InputFile   **input_files   = NULL;
 int        nb_input_files   = 0;
@@ -694,6 +697,57 @@
         }
     }
 
+    // scaleplex/PLEX: canThrottle feedback. Open a one-shot PUT to
+    // canthrottle_url, read response body, parse for `canThrottle`
+    // substring. Sets atomic per-output-frame sleep accordingly.
+    // Errors fail-open. Mirrors Plex's PMS_IssueHttpRequest helper
+    // (fftools/plex.c L63-114): AVIO_FLAG_READ, avio_size() for
+    // exact byte count, then avio_read(size).
+    //
+    // Log policy: per-cycle PUT / read / body lines at AV_LOG_DEBUG
+    // (hidden by default `-loglevel info`). State-transition
+    // ON/OFF lines at AV_LOG_INFO so operators see when PMS first
+    // asserts canThrottle without bumping global loglevel. Worker
+    // can flip the cutoff via env SCALEPLEX_FFMPEG_LOGLEVEL=debug
+    // when troubleshooting.
+    if (canthrottle_url && !is_last_report) {
+        AVIOContext *ct_avio = NULL;
+        AVDictionary *opts = NULL;
+        av_dict_set(&opts, "method", "PUT", 0);
+        int ct_ret = avio_open2(&ct_avio, canthrottle_url,
+                                AVIO_FLAG_READ, NULL, &opts);
+        av_dict_free(&opts);
+        av_log(NULL, AV_LOG_DEBUG,
+               "scaleplex/ct: PUT %s -> ret=%d\n",
+               canthrottle_url, ct_ret);
+        if (ct_ret >= 0) {
+            int64_t size = avio_size(ct_avio);
+            if (size < 0 || size > 4095)
+                size = 4095;
+            if (size > 0) {
+                char resp[4096];
+                int n = avio_read(ct_avio, (unsigned char *)resp, size);
+                av_log(NULL, AV_LOG_DEBUG,
+                       "scaleplex/ct: avio_read n=%d (size=%" PRId64 ")\n",
+                       n, size);
+                if (n > 0) {
+                    resp[n] = 0;
+                    av_log(NULL, AV_LOG_DEBUG,
+                           "scaleplex/ct: body=%.200s\n", resp);
+                    int new_throttle = strstr(resp, "canThrottle") ? 100 * 1000 : 0;
+                    int prev = scaleplex_throttle_delay_us;
+                    if (new_throttle != prev) {
+                        av_log(NULL, AV_LOG_INFO,
+                               "scaleplex/ct: throttle %s\n",
+                               new_throttle ? "ON" : "OFF");
+                    }
+                    scaleplex_throttle_delay_us = new_throttle;
+                }
+            }
+            avio_closep(&ct_avio);
+        }
+    }
+
     first_report = 0;
 }
 
