--- a/fftools/ffmpeg_enc.c	2026-05-11 13:58:17.000000000 +0200
+++ b/fftools/ffmpeg_enc.c	2026-05-12 10:40:05.000000000 +0200
@@ -891,6 +891,19 @@
         av_packet_unref(et.pkt);
         av_frame_unref(et.frame);
 
+        // scaleplex/PLEX: per-output-frame sleep on the VIDEO encoder
+        // thread when PMS asserts canThrottle. Plex 6.x sleeps in the
+        // single-threaded transcode loop after process_input_packet,
+        // gated by encoder pace. In jellyfin 7.x demuxer/encoder run
+        // in separate threads, so the equivalent gate is here: per
+        // encoded video frame. VIDEO-ONLY because parallel audio/sub
+        // threads would compound the sleep into multi-stream over-
+        // throttle (e.g. 0.28x video x 0.28x audio = 0.08x net).
+        // 23.976 fps x 100 ms = ~28% throughput when asserted,
+        // matching Plex's documented rate.
+        if (ost->type == AVMEDIA_TYPE_VIDEO && scaleplex_throttle_delay_us > 0)
+            av_usleep(scaleplex_throttle_delay_us);
+
         if (ret < 0) {
             if (ret == AVERROR_EOF)
                 av_log(ost, AV_LOG_VERBOSE, "Encoder returned EOF, finishing\n");
