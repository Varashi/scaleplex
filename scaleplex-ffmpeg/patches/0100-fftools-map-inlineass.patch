@@ -0,0 +1,235 @@
+/*
+ * scaleplex: fftools-side wiring for vf_inlineass.
+ *
+ * See scaleplex_inlineass.h for the API contract and the cover
+ * letter of patch 0100-fftools-map-inlineass.patch for design
+ * notes (the 6.x→7.x threading translation in particular).
+ *
