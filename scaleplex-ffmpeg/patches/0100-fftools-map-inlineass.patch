+/*
+ * scaleplex: fftools-side wiring for vf_inlineass.
+ *
+ * Backport of Plex Transcoder's fftools/plex.c subtitle hooks for
+ * jellyfin-ffmpeg 7.1.3. Provides:
+ *   - the -map_inlineass option handler
+ *   - a registry mapping (input_file, stream_spec) bindings to
+ *     AVFilterContext* once filter graphs are configured
+ *   - the per-subtitle-packet feed that forwards decoded data to
+ *     vf_inlineass via its public side-channel helpers
+ *
+ * This file is part of scaleplex / FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef FFTOOLS_SCALEPLEX_INLINEASS_H
+#define FFTOOLS_SCALEPLEX_INLINEASS_H
+
+#include "libavcodec/avcodec.h"
+
+struct AVFilterGraph;
+
+/* Option handler for `-map_inlineass FILE:STREAM_SPEC`.
+ * Called during argv parse. Resolves the stream specifier against
+ * the named input file (which is already open at this point) and
+ * queues a binding entry. Returns 0 on success, AVERROR on failure. */
+int scaleplex_inlineass_opt(void *optctx, const char *opt, const char *arg);
+
+/* Called from configure_filtergraph() in ffmpeg_filter.c after
+ * avfilter_graph_config() succeeds. Walks the graph's filters for
+ * any whose AVFilter->name is "inlineass", and binds each to the
+ * next unbound registry entry. For each bound filter, attaches the
+ * input file's font streams and pushes the buffersink dims. */
+void scaleplex_inlineass_link_graph(struct AVFilterGraph *graph);
+
+/* Called from transcode_subtitles() in ffmpeg_dec.c each time a
+ * subtitle packet decodes successfully. Looks up the binding by
+ * AVCodecContext* and (if found) forwards the AVSubtitle to
+ * vf_inlineass via avfilter_inlineass_append_data. No-op when no
+ * binding matches the decoder. */
+void scaleplex_inlineass_handle_subtitle(AVCodecContext *dec_ctx,
+                                         AVSubtitle *sub);
+
+/* Frees the binding registry. Currently unused (the registry lives
+ * for the lifetime of ffmpeg) but useful in case ffmpeg.c gains an
+ * explicit shutdown path that wants to assert no leaks. */
+void scaleplex_inlineass_uninit(void);
+
+#endif /* FFTOOLS_SCALEPLEX_INLINEASS_H */
