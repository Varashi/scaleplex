+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "scaleplex_inlineass.h"
+
+#include <pthread.h>
+#include <string.h>
+
+#include "cmdutils.h"
+#include "ffmpeg.h"
+#include "libavfilter/avfilter.h"
+#include "libavfilter/vf_inlineass.h"
+#include "libavformat/avformat.h"
+#include "libavutil/avstring.h"
+#include "libavutil/error.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+
+typedef struct InlineAssBinding {
+    int               file_idx;
+    char             *stream_spec;
+    InputStream      *ist;          /* resolved at option-parse time */
+    AVCodecContext   *dec_ctx;      /* resolved at link-graph time   */
+    AVFilterContext  *flt_ctx;      /* resolved at link-graph time   */
+} InlineAssBinding;
+
+static InlineAssBinding *bindings;
+static int               nb_bindings;
+static pthread_mutex_t   bindings_lock = PTHREAD_MUTEX_INITIALIZER;
+
+int scaleplex_inlineass_opt(void *optctx, const char *opt, const char *arg)
+{
+    char *endptr = NULL;
+    long  file_idx;
+    const char *spec;
+    InputFile   *f;
+    InputStream *match = NULL;
+    InlineAssBinding *nb;
+    int ret;
+
+    (void)optctx;
+    (void)opt;
+
+    if (!arg || !*arg) {
+        av_log(NULL, AV_LOG_FATAL,
+               "-map_inlineass: empty argument (expected FILE:STREAM_SPEC)\n");
+        return AVERROR(EINVAL);
+    }
+
+    file_idx = strtol(arg, &endptr, 0);
+    if (endptr == arg || file_idx < 0 || file_idx >= nb_input_files) {
+        av_log(NULL, AV_LOG_FATAL,
+               "-map_inlineass: invalid input file index in '%s' (nb_input_files=%d)\n",
+               arg, nb_input_files);
+        return AVERROR(EINVAL);
+    }
+    if (*endptr != ':') {
+        av_log(NULL, AV_LOG_FATAL,
+               "-map_inlineass: expected ':' after file index in '%s'\n", arg);
+        return AVERROR(EINVAL);
+    }
+    spec = endptr + 1;
+    if (!*spec) {
+        av_log(NULL, AV_LOG_FATAL,
+               "-map_inlineass: empty stream specifier in '%s'\n", arg);
+        return AVERROR(EINVAL);
+    }
+
+    f = input_files[file_idx];
+    for (int i = 0; i < f->nb_streams; i++) {
+        ret = check_stream_specifier(f->ctx, f->streams[i]->st, spec);
+        if (ret < 0) {
+            av_log(NULL, AV_LOG_FATAL,
+                   "-map_inlineass: stream specifier '%s' rejected: %s\n",
+                   spec, av_err2str(ret));
+            return ret;
+        }
+        if (ret == 1) {
+            match = f->streams[i];
+            break;
+        }
+    }
+    if (!match) {
+        av_log(NULL, AV_LOG_FATAL,
+               "-map_inlineass: no stream in input #%ld matches '%s'\n",
+               file_idx, spec);
+        return AVERROR(EINVAL);
+    }
+
+    pthread_mutex_lock(&bindings_lock);
+    nb = av_realloc_array(bindings, nb_bindings + 1, sizeof(*bindings));
+    if (!nb) {
+        pthread_mutex_unlock(&bindings_lock);
+        return AVERROR(ENOMEM);
+    }
+    bindings = nb;
+    InlineAssBinding *b = &bindings[nb_bindings++];
+    memset(b, 0, sizeof(*b));
+    b->file_idx    = (int)file_idx;
+    b->stream_spec = av_strdup(spec);
+    b->ist         = match;
+    pthread_mutex_unlock(&bindings_lock);
+
+    av_log(NULL, AV_LOG_VERBOSE,
+           "scaleplex_inlineass: queued binding #%d for input #%ld:%s\n",
+           nb_bindings - 1, file_idx, spec);
+    return 0;
+}
+
+void scaleplex_inlineass_link_graph(struct AVFilterGraph *graph)
+{
+    int cursor = 0;
+
+    if (!graph)
+        return;
+
+    pthread_mutex_lock(&bindings_lock);
+    if (!nb_bindings) {
+        pthread_mutex_unlock(&bindings_lock);
+        return;
+    }
+
+    /* configure_filtergraph may be invoked multiple times for the same
+     * session (probe pass + live pass, or on reconfigure). Each invocation
+     * builds a fresh AVFilterGraph and previous filter contexts are freed.
+     * Reset all flt_ctx/dec_ctx pointers before binding to this graph's
+     * filter instances — otherwise handle_subtitle would dereference a
+     * freed AVFilterContext from a previous graph. */
+    for (int i = 0; i < nb_bindings; i++) {
+        bindings[i].flt_ctx = NULL;
+        bindings[i].dec_ctx = NULL;
+    }
+
+    for (unsigned i = 0; i < graph->nb_filters; i++) {
+        AVFilterContext *fc = graph->filters[i];
+        InlineAssBinding *b = NULL;
+        InputFile *src;
+
+        if (!fc || !fc->filter || !fc->filter->name ||
+            strcmp(fc->filter->name, "inlineass") != 0)
+            continue;
+
+        /* Find next unbound entry. */
+        while (cursor < nb_bindings) {
+            if (!bindings[cursor].flt_ctx) {
+                b = &bindings[cursor];
+                cursor++;
+                break;
+            }
+            cursor++;
+        }
+        if (!b) {
+            av_log(NULL, AV_LOG_WARNING,
+                   "scaleplex_inlineass: graph has more inlineass filters than -map_inlineass bindings; extras left unbound\n");
+            break;
+        }
+
+        b->flt_ctx = fc;
+        b->dec_ctx = b->ist && b->ist->decoder ? dec_get_avctx(b->ist->decoder) : NULL;
+
+        /* Push font attachments from the same input file. */
+        src = input_files[b->file_idx];
+        for (int j = 0; j < src->nb_streams; j++) {
+            AVStream *st = src->streams[j]->st;
+            if (st->codecpar->codec_type == AVMEDIA_TYPE_ATTACHMENT)
+                avfilter_inlineass_add_attachment(fc, st);
+        }
+        avfilter_inlineass_set_fonts(fc);
+
+        /* Push the SUBTITLE STREAM's stored PlayResX/PlayResY (ASS
+         * script's intended canvas) so libass scales script coords
+         * to the actual render frame_size (config_input sets that
+         * to the inlink's w/h). Plex's fftools/plex.c uses the same
+         * source: ist->st->codecpar->width/height. Using fc->outputs[0]
+         * dims (the VIDEO frame size) instead would tell libass the
+         * script is authored for the frame's resolution → script
+         * MarginV / \pos coordinates land at the wrong vertical
+         * position. Live-confirmed 2026-05-12 on Plex Android
+         * (Super HxEros, embedded ASS): bottom-aligned subs clipping
+         * below the frame when storage_size was set from
+         * fc->outputs[0] (1920x1080) instead of the sub stream's
+         * codecpar (matches script PlayResY). */
+        if (b->ist && b->ist->st && b->ist->st->codecpar) {
+            int w = b->ist->st->codecpar->width;
+            int h = b->ist->st->codecpar->height;
+            if (w > 0 && h > 0)
+                avfilter_inlineass_set_storage_size(fc, w, h);
+        }
+
+        av_log(NULL, AV_LOG_VERBOSE,
+               "scaleplex_inlineass: bound filter to input #%d:%s (dec_ctx=%p)\n",
+               b->file_idx, b->stream_spec, (void*)b->dec_ctx);
+    }
+    pthread_mutex_unlock(&bindings_lock);
+}
+
+void scaleplex_inlineass_handle_subtitle(AVCodecContext *dec_ctx, AVSubtitle *sub)
+{
+    if (!dec_ctx || !sub)
+        return;
+
+    pthread_mutex_lock(&bindings_lock);
+    for (int i = 0; i < nb_bindings; i++) {
+        if (bindings[i].dec_ctx == dec_ctx && bindings[i].flt_ctx) {
+            av_log(NULL, AV_LOG_VERBOSE,
+                   "scaleplex_inlineass: handle_subtitle bind#%d dec_ctx=%p flt_ctx=%p rects=%d\n",
+                   i, (void*)dec_ctx, (void*)bindings[i].flt_ctx, sub->num_rects);
+            avfilter_inlineass_append_data(bindings[i].flt_ctx, dec_ctx, sub);
+            break;
+        }
+    }
+    pthread_mutex_unlock(&bindings_lock);
+}
+
+void scaleplex_inlineass_uninit(void)
+{
+    pthread_mutex_lock(&bindings_lock);
+    for (int i = 0; i < nb_bindings; i++)
+        av_freep(&bindings[i].stream_spec);
+    av_freep(&bindings);
+    nb_bindings = 0;
+    pthread_mutex_unlock(&bindings_lock);
+}
