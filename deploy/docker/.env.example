# scaleplex Docker deployment — env file template.
# Copy to ./.env (same directory as compose.yaml) and adjust.

# ─── Image tag ────────────────────────────────────────────────────────
# Pin a specific release for reproducibility (renovate can manage
# this). `latest` works but means a `docker compose pull` may roll
# you forward unexpectedly.
IMAGE_TAG=latest

# ─── Storage ──────────────────────────────────────────────────────────
# Paths visible inside the worker (and PMS if you uncomment that
# stanza). On a single host, plain bind-mount paths are fine. On
# multi-host, point both at the SAME NFS / SMB mount on every box
# (worker writes segments where PMS reads them).
MEDIA_DIR=./media
TRANSCODE_DIR=./transcode

# ─── Backend ──────────────────────────────────────────────────────────
# Worker transcode backend. `auto` (default) probes the hardware:
# /dev/nvidia0 → nvenc, else a DRM render node → vaapi, else sw (CPU).
# Pin only for edge cases: vaapi | nvenc (alias nvidia) | sw (alias cpu).
# One image serves all three; the device grant below (or `runtime: nvidia`
# / `gpus: all` for NVIDIA, or nothing for CPU) decides what the worker is.
WORKER_BACKEND=auto

# ─── GPU device ───────────────────────────────────────────────────────
# Intel iGPU / Arc render node (VAAPI). `ls -l /dev/dri` to confirm.
# Ignored on a CPU (sw) worker; for NVIDIA use the nvidia runtime instead.
WORKER_RENDER_DEV=/dev/dri/renderD128

# ─── Network ──────────────────────────────────────────────────────────
# Host port the orchestrator listens on (PMS shim posts here).
ORCHESTRATOR_PORT=3500

# ─── Discovery ────────────────────────────────────────────────────────
# Static comma-separated list of remote worker host[:port] entries
# merged with DNS-discovered workers. Leave empty for single-host
# compose; set on the orchestrator host when adding workers running
# on other boxes via plain `docker run` (no PUSH).
#   WORKERS_LIST=worker-b.lan:3501,worker-c.lan:3501
WORKERS_LIST=

# ─── Transcoder knobs ─────────────────────────────────────────────────
# Force HW re-acceleration even when Plex emits a SW argv (homelab
# default = 1). Set to 0 for honor-Plex behavior — relevant for
# hetero or CPU-only fleets.
SCALEPLEX_FORCE_HW=1

# HDR tonemap path: `opencl` (algo-honored, Plex's chosen algorithm,
# default) or `vaapi` (fixed-curve BT.2390 EETF, lower CPU).
SCALEPLEX_TONEMAP=opencl

# Soft per-worker session cap. 0 = unlimited. Worth a low value on a
# CPU (sw) worker so it doesn't accept more than it can handle.
WORKER_MAX_SESSIONS=0

# ─── Scheduling (orchestrator, heterogeneous fleets) ──────────────────
# Tier HW workers above SW (CPU = overflow). 1 = default. 0 = one flat
# pool. No-op on a homogeneous fleet.
SCALEPLEX_PREFER_HW=1
# Within-tier ordering: load (default) | round-robin | least-sessions | random
SCALEPLEX_LB_STRATEGY=load

# ─── Plex (optional, only if you uncomment the plex service) ──────────
# Get a claim token at https://www.plex.tv/claim/ (valid 4 min).
# After first start the server is claimed; remove this value.
PLEX_CLAIM=
PLEX_CONFIG_DIR=./plex-config
TZ=Etc/UTC
